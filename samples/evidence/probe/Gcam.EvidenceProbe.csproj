    <ProjectReference Include="..\..\..\src\Gcam.Masks\Gcam.Masks.csproj" />
    <ProjectReference Include="..\..\..\src\Gcam.Simulation\Gcam.Simulation.csproj" />
    <ProjectReference Include="..\..\..\src\Gcam.Detector\Gcam.Detector.csproj" />
    <ProjectReference Include="..\..\..\src\Gcam.Decoding\Gcam.Decoding.csproj" />
    <ProjectReference Include="..\..\..\src\Gcam.Studio.Core\Gcam.Studio.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Gcam.Studio.Services\Gcam.Studio.Services.csproj" />
  </ItemGroup>

</Project>
