<Project Sdk="Microsoft.NET.Sdk">

  <!-- Service implementations: the only Studio layer that touches the simulation engine. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Gcam.Studio.Services</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gcam.Studio.Core\Gcam.Studio.Core.csproj" />
    <ProjectReference Include="..\Gcam.Simulation\Gcam.Simulation.csproj" />
  </ItemGroup>

  <!-- Studio's ambient preset (AB-15): the validated, hash-pinned terrestrial spectrum, deployed byte-for-byte beside
       the assemblies; SimulationService resolves it there and the engine loader checks it against the pinned SHA-256. -->
  <ItemGroup>
    <None Include="..\..\samples\ambient\terrestrial-unscear2000-v1.json" Link="ambient\terrestrial-unscear2000-v1.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TODO-41 (SD-A13): the generated readout offer / cost record, compiled in as a read-only resource and checked at
       load against ReadoutOfferPin.Sha256; Studio never reads it from disk, TEMP or the network. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\evidence\studio-readout\offer-cost-v1.json"
                      LogicalName="Gcam.Studio.Services.ReadoutOfferRecord.json" />
  </ItemGroup>

</Project>
