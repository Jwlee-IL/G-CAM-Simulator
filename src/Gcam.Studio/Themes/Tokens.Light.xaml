<!--
    Colour tokens — LIGHT. Same keys as Tokens.Dark.xaml; the accent is darkened so text-on-surface and
    white-on-accent both stay above WCAG AA (Accent #0D6583 on white 6.4:1).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Bg.Canvas">#F3F5F7</Color>
    <Color x:Key="Color.Bg.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Bg.Raised">#F0F3F5</Color>
    <Color x:Key="Color.Bg.Hover">#E6EBEF</Color>
    <Color x:Key="Color.Line">#DDE3E8</Color>
    <Color x:Key="Color.Line.Control">#7F8D99</Color>
    <Color x:Key="Color.Text.Primary">#1B242D</Color>
    <Color x:Key="Color.Text.Secondary">#56636F</Color>
    <Color x:Key="Color.Text.Disabled">#9AA5AE</Color>
    <Color x:Key="Color.Accent">#0D6583</Color>
    <Color x:Key="Color.Accent.Hover">#0F7596</Color>
    <Color x:Key="Color.Accent.Pressed">#0A5269</Color>
    <Color x:Key="Color.Accent.Subtle">#1F0D6583</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Focus">#0D6583</Color>
    <Color x:Key="Color.Status.Success">#1E7F4F</Color>
    <Color x:Key="Color.Status.Warning">#9A6A00</Color>
    <Color x:Key="Color.Status.Error">#C2362E</Color>
    <Color x:Key="Color.Selection">#4D0D6583</Color>

    <SolidColorBrush x:Key="Brush.Bg.Canvas" Color="{StaticResource Color.Bg.Canvas}" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{StaticResource Color.Bg.Surface}" />
    <SolidColorBrush x:Key="Brush.Bg.Raised" Color="{StaticResource Color.Bg.Raised}" />
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="{StaticResource Color.Bg.Hover}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Line.Control" Color="{StaticResource Color.Line.Control}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />

    <!-- Plot data colours are separate from UI action / selection colours. -->
    <Color x:Key="Color.Plot.Series1">#17693C</Color>
    <SolidColorBrush x:Key="Brush.Plot.Series1" Color="{StaticResource Color.Plot.Series1}" />
    <Color x:Key="Color.Plot.Series2">#855500</Color>
    <SolidColorBrush x:Key="Brush.Plot.Series2" Color="{StaticResource Color.Plot.Series2}" />
    <Color x:Key="Color.Plot.Series3">#6742A6</Color>
    <SolidColorBrush x:Key="Brush.Plot.Series3" Color="{StaticResource Color.Plot.Series3}" />
    <Color x:Key="Color.Plot.Band">#26808080</Color>
    <SolidColorBrush x:Key="Brush.Plot.Band" Color="{StaticResource Color.Plot.Band}" />
    <Color x:Key="Color.Plot.BandEdge">#505050</Color>
    <SolidColorBrush x:Key="Brush.Plot.BandEdge" Color="{StaticResource Color.Plot.BandEdge}" />
    <Color x:Key="Color.Plot.Grid">#CCD4DC</Color>
    <SolidColorBrush x:Key="Brush.Plot.Grid" Color="{StaticResource Color.Plot.Grid}" />
</ResourceDictionary>
