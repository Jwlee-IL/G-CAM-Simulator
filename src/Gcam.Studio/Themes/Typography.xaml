<!-- Text roles. Views pick a role (Text.*) rather than setting font size / weight / colour ad hoc. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StaticResource can't see sibling dictionaries at load time, so pull in what this one needs. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- App name in the top bar -->
    <Style x:Key="Text.AppTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
        Headings carry no margin: they sit in a PanelHeader row (Controls.xaml), which owns the gap below and the
        row height, so a title lines up with the buttons next to it.
    -->
    <!-- Panel title: the top of a panel ("Sources", "Detector flood map") -->
    <Style x:Key="Text.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Section title: a group inside a panel ("Selected source", "Measurements") -->
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

    <!-- Emphasised body text, e.g. the isotope in a source row -->
    <Style x:Key="Text.Strong" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Field labels and secondary text -->
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Caption in the warning colour, for a status chip ("outdated") or a validation message. A message line with
         no message takes no height: an empty TextBlock would otherwise still measure one line. -->
    <Style x:Key="Text.CaptionWarning" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Table column headers -->
    <Style x:Key="Text.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Numbers, coordinates, units: monospaced so columns of values line up -->
    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    </Style>

    <Style x:Key="Text.MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Hovered-pixel readout under an image: one reserved line, so the layout doesn't jump when it empties -->
    <Style x:Key="Text.Readout" TargetType="TextBlock" BasedOn="{StaticResource Text.MonoCaption}">
        <Setter Property="Height" Value="{StaticResource Size.ReadoutLine}" />
    </Style>
</ResourceDictionary>
