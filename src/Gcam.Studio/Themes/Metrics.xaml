<!--
    Layout metrics and type scale — theme-independent, referenced with StaticResource.
    Spacing is a 4 px grid (4, 8, 12, 16, 24, 32). XAML can't build a Thickness from Double keys, so the grid is
    expressed directly as named Thickness resources (Pad.* = padding, Gap.* = margin) — views use those, never numbers.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Padding -->
    <Thickness x:Key="Pad.Window">12</Thickness>
    <Thickness x:Key="Pad.Panel">12</Thickness>
    <Thickness x:Key="Pad.Bar">16,0</Thickness>
    <Thickness x:Key="Pad.Control">8,0</Thickness>
    <Thickness x:Key="Pad.Button">12,0</Thickness>
    <Thickness x:Key="Pad.ListItem">8,0</Thickness>

    <!-- Margins (Gap = space after an element) -->
    <Thickness x:Key="Gap.Tight">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Field">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Section">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.Title">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Inline">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.InlineWide">0,0,16,0</Thickness>
    <GridLength x:Key="Gutter">12</GridLength>

    <!-- Sizes -->
    <sys:Double x:Key="Size.Control">28</sys:Double>
    <GridLength x:Key="Size.Bar">48</GridLength>
    <GridLength x:Key="Size.StatusBar">28</GridLength>
    <GridLength x:Key="Size.SidePanel">300</GridLength>
    <sys:Double x:Key="Size.FieldLabel">84</sys:Double>
    <sys:Double x:Key="Size.ColorBar">8</sys:Double>
    <sys:Double x:Key="Size.ReadoutLine">16</sys:Double>
    <sys:Double x:Key="Size.Logo">16</sys:Double>
    <sys:Double x:Key="Size.Icon">12</sys:Double>
    <sys:Double x:Key="Size.StatusDot">8</sys:Double>
    <!-- Short acquisition numbers plus their suffix; leaves room for the workspace switch. -->
    <sys:Double x:Key="Size.NumberInput.Short">80</sys:Double>
    <sys:Double x:Key="Size.NumberInput">120</sys:Double>
    <sys:Double x:Key="Size.Progress">160</sys:Double>
    <!-- Lists grow with their rows up to these heights, then scroll -->
    <sys:Double x:Key="Size.SourceList">168</sys:Double>
    <sys:Double x:Key="Size.ResultsList">280</sys:Double>
    <!-- Results-table columns (the last column takes the rest) -->
    <GridLength x:Key="Size.Column.Id">36</GridLength>
    <GridLength x:Key="Size.Column.Short">60</GridLength>

    <!-- Shape -->
    <CornerRadius x:Key="Radius.Control">3</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">10</CornerRadius>
    <Thickness x:Key="Border.Hairline">1</Thickness>

    <!-- Type -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Label">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Title">14</sys:Double>
</ResourceDictionary>
