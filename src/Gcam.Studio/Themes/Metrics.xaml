<!--
    Layout metrics and type scale — theme-independent, referenced with StaticResource.
    Spacing is a 4 px grid (4, 8, 12, 16, 24, 32). XAML can't build a Thickness from Double keys, so the grid is
    expressed directly as named Thickness resources (Pad.* = padding, Gap.* = margin) — views use those, never numbers.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Padding -->
    <Thickness x:Key="Pad.Window">12</Thickness>
    <Thickness x:Key="Pad.Panel">12</Thickness>
    <Thickness x:Key="Pad.Bar">16,0</Thickness>
    <Thickness x:Key="Pad.Control">8,0</Thickness>
    <Thickness x:Key="Pad.Button">12,0</Thickness>
    <Thickness x:Key="Pad.ListItem">8,0</Thickness>
    <!-- Clear plot lines beneath band labels, including labels wider than their interval. -->
    <Thickness x:Key="Pad.Plot.BandLabel">4</Thickness>

    <!-- Margins (Gap = space after an element) -->
    <Thickness x:Key="Gap.Tight">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Field">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Section">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.Title">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Inline">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.InlineWide">0,0,16,0</Thickness>
    <GridLength x:Key="Gutter">12</GridLength>
    <!-- Vertical gutter between stacked panels: the same 12 as the column gutter -->
    <Thickness x:Key="Gap.Row">0,0,0,12</Thickness>

    <!-- Sizes -->
    <sys:Double x:Key="Size.Control">28</sys:Double>
    <GridLength x:Key="Size.Bar">48</GridLength>
    <GridLength x:Key="Size.SidePanel">300</GridLength>
    <sys:Double x:Key="Size.FieldLabel">84</sys:Double>
    <sys:Double x:Key="Size.ColorBar">8</sys:Double>
    <sys:Double x:Key="Size.ReadoutLine">16</sys:Double>
    <sys:Double x:Key="Size.Logo">16</sys:Double>
    <sys:Double x:Key="Size.Icon">12</sys:Double>
    <!-- Circled "?" help mark: large enough for a caption-size glyph inside a hairline ring. -->
    <sys:Double x:Key="Size.HelpMark">15</sys:Double>
    <!-- A help mark follows the text it explains: a small gap on its left only. -->
    <Thickness x:Key="Gap.HelpMark">6,0,0,0</Thickness>
    <!-- A help-mark tooltip wraps at the side-panel width (a double for MaxWidth; Size.SidePanel is a GridLength). -->
    <sys:Double x:Key="Size.HelpMark.TooltipWidth">300</sys:Double>
    <sys:Double x:Key="Size.Imaging.FoundMarker">7</sys:Double>
    <sys:Double x:Key="Space.Imaging.FoundLabel">4</sys:Double>
    <sys:Double x:Key="Space.Imaging.LabelGap">4</sys:Double>
    <sys:Double x:Key="Size.StatusDot">8</sys:Double>
    <!-- Short acquisition numbers plus their suffix; leaves room for the workspace switch. -->
    <sys:Double x:Key="Size.NumberInput.Short">80</sys:Double>
    <sys:Double x:Key="Size.NumberInput">120</sys:Double>
    <sys:Double x:Key="Size.Progress">160</sys:Double>
    <!-- Lists grow with their rows up to these heights, then scroll -->
    <sys:Double x:Key="Size.SourceList">168</sys:Double>
    <sys:Double x:Key="Size.ResultsList">280</sys:Double>
    <!-- Results-table columns (the last column takes the rest) -->
    <GridLength x:Key="Size.Column.Id">36</GridLength>
    <GridLength x:Key="Size.Column.Short">60</GridLength>
    <!-- Numeric table columns wide enough for "616.3–707.1" in the mono face (emission-window table) -->
    <GridLength x:Key="Size.Column.Value">96</GridLength>

    <!-- Shape -->
    <CornerRadius x:Key="Radius.Control">3</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">10</CornerRadius>
    <Thickness x:Key="Border.Hairline">1</Thickness>

    <!-- Type -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Label">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Title">14</sys:Double>
    <!-- Imaging centre: height always left under the image pair for measurements and the focus curve -->
    <sys:Double x:Key="Size.Imaging.Lower">240</sys:Double>
    <GridLength x:Key="Size.Compare.Spectrum">180</GridLength>
    <sys:Double x:Key="Size.Modal">480</sys:Double>
    <sys:Double x:Key="Size.Caption">47</sys:Double>
    <sys:Double x:Key="Size.Options">520</sys:Double>
    <sys:Double x:Key="Size.Options.LockCaption">16</sys:Double>
    <sys:Double x:Key="Size.CaptionButton">46</sys:Double>
    <Thickness x:Key="Gap.Caption.Focus">2</Thickness>
    <Thickness x:Key="Pad.None">0</Thickness>
    <Thickness x:Key="Gap.TabContent">0,12,0,0</Thickness>
    <sys:Double x:Key="Size.OptionsBadge">4</sys:Double>
    <!-- A row action button (Button.Icon.Row): a Size.Icon glyph plus 4 px on each side, inside a Size.Control list row. -->
    <sys:Double x:Key="Size.Control.Row">20</sys:Double>
    <!-- Between the measurement tool toggles; before a row's action button (after the Value column). -->
    <Thickness x:Key="Gap.Tool">0,0,4,0</Thickness>
    <Thickness x:Key="Gap.RowAction">8,0,0,0</Thickness>
    <!-- Scroll gutter: every vertically scrolling ScrollViewer reserves Size.ScrollGutter at its right, whether or not the bar
    shows (content width never jumps): 4 px between the content and the bar, then the Size.ScrollBar (8) bar, which ends at
    the scroller's right edge, inside the panel's padding (so the thumb clears the panel's rounded border). Header rows of
    lists reserve the same width with Gap.ScrollGutter, so their columns stay over the rows' columns. -->
    <sys:Double x:Key="Size.ScrollBar">8</sys:Double>
    <sys:Double x:Key="Size.ScrollGutter">12</sys:Double>
    <Thickness x:Key="Gap.ScrollGutter">0,0,12,0</Thickness>
    <!-- Before an item that follows another on the same line (status-bar messages). -->
    <Thickness x:Key="Gap.InlineWide.Leading">16,0,0,0</Thickness>
</ResourceDictionary>
