<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF shell: views, controls, converters, and the DI composition root. No business logic here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Gcam.Studio</RootNamespace>
    <AssemblyName>Gcam.Studio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gcam.Studio.Core\Gcam.Studio.Core.csproj" />
    <ProjectReference Include="..\Gcam.Studio.Services\Gcam.Studio.Services.csproj" />
  </ItemGroup>

</Project>
