<UserControl x:Class="Gcam.Studio.Views.ReadoutDetectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls"
        xmlns:conv="clr-namespace:Gcam.Studio.Converters">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Style="{StaticResource PanelHeader}">
                <TextBlock Text="Experimental four-output head" Style="{StaticResource Text.PanelTitle}" />
            </DockPanel>
            <Border Style="{StaticResource Segment.Track}" Margin="{StaticResource Gap.Field}">
                <UniformGrid Rows="1">
                    <RadioButton Content="SiPM" GroupName="ReadoutTab" Style="{StaticResource RadioButton.Segment}"
                            IsChecked="{Binding ReadoutTab, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Sipm}"
                            AutomationProperties.AutomationId="Readout.SipmTab" />
                    <RadioButton Content="Anger" GroupName="ReadoutTab" Style="{StaticResource RadioButton.Segment}"
                            IsChecked="{Binding ReadoutTab, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Anger}"
                            AutomationProperties.AutomationId="Readout.AngerTab" />
                    <RadioButton Content="Calibration" GroupName="ReadoutTab" Style="{StaticResource RadioButton.Segment}"
                            IsChecked="{Binding ReadoutTab, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Calibration}"
                            AutomationProperties.AutomationId="Readout.CalibrationTab" />
                    <RadioButton Content="Diagnostics" GroupName="ReadoutTab" Style="{StaticResource RadioButton.Segment}"
                            IsChecked="{Binding ReadoutTab, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Diagnostics}"
                            AutomationProperties.AutomationId="Readout.DiagnosticsTab" />
                </UniformGrid>
            </Border>
            <DockPanel Margin="{StaticResource Gap.Field}">
                <TextBlock Text="Calibration line (keV)" Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                        Margin="{StaticResource Gap.Inline}" />
                <ComboBox ItemsSource="{Binding BankLines}" SelectedItem="{Binding ShownLineKeV}"
                        AutomationProperties.AutomationId="Readout.Line" AutomationProperties.Name="Calibration line (keV)" />
            </DockPanel>
            <TextBlock Text="{Binding PhysicalCounts}" Style="{StaticResource Text.MonoCaption}" TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Readout.Counts" />
        </StackPanel>
        <Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Calibration">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Diagnostics">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <DockPanel>
                            <c:HelpMark DockPanel.Dock="Right"
                                    Text="{Binding MapHelp, Mode=OneTime}"
                                    AutomationProperties.AutomationId="Readout.MapHelp" AutomationProperties.Name="Map legend and navigation" />
                            <CheckBox x:Name="Live" Content="Live raw density (clear: calibration density)" Margin="{StaticResource Gap.Field}"
                                    AutomationProperties.AutomationId="Readout.LiveDensity" />
                        </DockPanel>
                        <TextBlock Text="{Binding Inspection, ElementName=Map}" Style="{StaticResource Text.MonoCaption}"
                                TextWrapping="Wrap" AutomationProperties.AutomationId="Readout.MapInspection" />
                    </StackPanel>
                    <c:ReadoutMapView x:Name="Map" Preparation="{Binding Preparation}" Snapshot="{Binding PhysicalSnapshot}"
                            Tab="{Binding ReadoutTab}" ShowLive="{Binding IsChecked, ElementName=Live}"
                            Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.Map"
                            AutomationProperties.Name="Resolved SiPM circuit or Anger flood and LUT" />
                </DockPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Calibration">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="Local preparation (this session)" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding CalibrationState}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"
                            AutomationProperties.AutomationId="Readout.CalibrationFacts" />
                    <DockPanel Margin="{StaticResource Gap.Tight}">
                        <c:HelpMark DockPanel.Dock="Right"
                                Text="{Binding OfferDetails}"
                                AutomationProperties.AutomationId="Readout.OfferDetails"
                                AutomationProperties.Name="Confirmed record: provenance, failures and diagnostics" />
                        <TextBlock Text="Confirmed offer per calibration line" Style="{StaticResource Text.Label}"
                                VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding OfferRows}" AutomationProperties.AutomationId="Readout.Offers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                        Margin="{StaticResource Gap.Tight}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                        <c:HelpMark DockPanel.Dock="Right"
                                Text="{Binding SensitivityHelp}"
                                AutomationProperties.AutomationId="Readout.SensitivityHelp"
                                AutomationProperties.Name="About the mean sensitivity map" />
                        <TextBlock Text="{Binding SensitivityCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                AutomationProperties.AutomationId="Readout.SensitivityCaption" />
                    </DockPanel>
                    <c:HeatmapView Image="{Binding SensitivitySummary}" Height="{StaticResource Size.Imaging.Lower}"
                            OriginMm="{Binding SensitivityOriginMm}" StepMm="{Binding SensitivityStepMm}" ValueUnit="validation ratio"
                            EmptyText="No offered-cell summary" AutomationProperties.AutomationId="Readout.SensitivityMap"
                            AutomationProperties.Name="Mean truth-referenced validation sensitivity map"
                            AutomationProperties.HelpText="Visual summary, never flood-correction weights. Row and column are crystal indices." />
                </StackPanel>
            </ScrollViewer>
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Diagnostics">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Gap.Tight}">
                    <c:HelpMark DockPanel.Dock="Right"
                            Text="{Binding DiagnosticsHelp, Mode=OneTime}"
                            AutomationProperties.AutomationId="Readout.DiagnosticsHelp"
                            AutomationProperties.Name="About the per-crystal check" />
                    <TextBlock Text="Local per-crystal check" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.AutomationId="Readout.Diagnostics">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.MonoCaption}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
