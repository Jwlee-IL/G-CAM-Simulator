<UserControl x:Class="Gcam.Studio.Views.ReadoutDetectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls"
        xmlns:conv="clr-namespace:Gcam.Studio.Converters">
    <!-- The physical readout's views (the switch is in DetectorView): the calibration line they show, then the SiPM / Anger
    map with its display toggle and hover readout, the Calibration view's mean sensitivity map, or the Diagnostics table.
    The calibration facts, confirmed offers and measured conversions are rows in the right panel (DetectorPanel). -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Style="{StaticResource FieldRow}">
            <TextBlock Text="Line" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding BankLines}" SelectedItem="{Binding ShownLineKeV}" HorizontalAlignment="Left"
                    MinWidth="{StaticResource Size.NumberInput}"
                    AutomationProperties.AutomationId="Readout.Line" AutomationProperties.Name="Calibration line (keV)" />
        </DockPanel>
        <Grid>
            <!-- SiPM / Anger: the map, then one display toggle and its readout line -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Calibration">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Diagnostics">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Bottom">
                    <DockPanel Margin="{StaticResource Gap.Tight}">
                        <c:HelpMark DockPanel.Dock="Right"
                                Text="{Binding MapHelp, Mode=OneTime}"
                                AutomationProperties.AutomationId="Readout.MapHelp" AutomationProperties.Name="Map legend and navigation" />
                        <CheckBox x:Name="Live" Content="Live raw density (clear: calibration density)"
                                AutomationProperties.AutomationId="Readout.LiveDensity" />
                    </DockPanel>
                    <TextBlock Text="{Binding Inspection, ElementName=Map}" Style="{StaticResource Text.Readout}"
                            TextTrimming="CharacterEllipsis" ToolTip="{Binding Inspection, ElementName=Map}"
                            AutomationProperties.AutomationId="Readout.MapInspection" />
                </StackPanel>
                <c:ReadoutMapView x:Name="Map" Preparation="{Binding Preparation}" Snapshot="{Binding PhysicalSnapshot}"
                        Tab="{Binding ReadoutTab}" ShowLive="{Binding IsChecked, ElementName=Live}"
                        Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.Map"
                        AutomationProperties.Name="Resolved SiPM circuit or Anger flood and LUT" />
            </DockPanel>
            <!-- Calibration: the confirmed record's mean sensitivity map (the local facts and the offers are in the right panel) -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Calibration">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <c:HelpMark DockPanel.Dock="Right"
                            Text="{Binding SensitivityHelp}"
                            AutomationProperties.AutomationId="Readout.SensitivityHelp"
                            AutomationProperties.Name="About the mean sensitivity map" />
                    <TextBlock Text="Mean sensitivity map" Style="{StaticResource Text.PanelTitle}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SensitivityCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                        Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.SensitivityCaption" />
                <c:ImageStackPanel>
                    <c:HeatmapView Image="{Binding SensitivitySummary}" x:Name="Sensitivity"
                            OriginMm="{Binding SensitivityOriginMm}" StepMm="{Binding SensitivityStepMm}" ValueUnit="validation ratio"
                            ShowReadoutOverlay="False" Foreground="{DynamicResource Brush.Text.Secondary}"
                            FrameBrush="{DynamicResource Brush.Line.Control}" FocusBrush="{DynamicResource Brush.Focus}"
                            EmptyText="No offered-cell summary" Margin="{StaticResource Gap.Field}"
                            AutomationProperties.AutomationId="Readout.SensitivityMap"
                            AutomationProperties.Name="Mean truth-referenced validation sensitivity map"
                            AutomationProperties.HelpText="Visual summary, never flood-correction weights. Row and column are crystal indices." />
                    <c:ColorBar Minimum="{Binding DataMin, ElementName=Sensitivity}" Maximum="{Binding DataMax, ElementName=Sensitivity}"
                            BarHeight="{StaticResource Size.ColorBar}" Foreground="{DynamicResource Brush.Text.Secondary}"
                            FontFamily="{StaticResource Font.Mono}" Margin="{StaticResource Gap.Tight}"
                            AutomationProperties.AutomationId="Readout.SensitivityScale"
                            AutomationProperties.Name="Sensitivity colour scale" />
                    <TextBlock Text="{Binding Readout, ElementName=Sensitivity}" Style="{StaticResource Text.Readout}"
                            AutomationProperties.AutomationId="Readout.SensitivityReadout" />
                </c:ImageStackPanel>
            </DockPanel>
            <!-- Diagnostics: the local per-crystal check as a table (crystal · assigned · wrong) -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadoutTab}" Value="Diagnostics">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <c:HelpMark DockPanel.Dock="Right"
                            Text="{Binding DiagnosticsHelp, Mode=OneTime}"
                            AutomationProperties.AutomationId="Readout.DiagnosticsHelp"
                            AutomationProperties.Name="About the per-crystal check" />
                    <TextBlock Text="Local per-crystal check" Style="{StaticResource Text.PanelTitle}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding DiagnosticScope}" TextWrapping="Wrap" Margin="{StaticResource Gap.Field}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel Grid.IsSharedSizeScope="True">
                    <Border DockPanel.Dock="Top" Padding="{StaticResource Pad.ListItem}" Margin="{StaticResource Gap.ScrollGutter}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagCrystal" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crystal" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.InlineWide}" />
                            <TextBlock Grid.Column="1" Text="Assigned / single-crystal" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" Margin="{StaticResource Gap.InlineWide}" />
                            <TextBlock Grid.Column="2" Text="Wrong / assigned" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                <ListBox ItemsSource="{Binding DiagnosticRows}"
                        AutomationProperties.AutomationId="Readout.Diagnostics" AutomationProperties.Name="Local per-crystal check">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DiagCrystal" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Crystal}" Style="{StaticResource Text.Mono}" Margin="{StaticResource Gap.InlineWide}" />
                                <TextBlock Grid.Column="1" Text="{Binding Assigned}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" Margin="{StaticResource Gap.InlineWide}" />
                                <TextBlock Grid.Column="2" Text="{Binding Wrong}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
                                <TextBlock Grid.ColumnSpan="3" Text="{Binding Note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                        Visibility="{Binding Note, Converter={x:Static conv:NullToCollapsedConverter.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
