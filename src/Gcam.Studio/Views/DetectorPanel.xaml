<UserControl x:Class="Gcam.Studio.Views.DetectorPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls">
    <Border Style="{StaticResource Panel.Surface}" VerticalAlignment="Top">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Style="{StaticResource PanelHeader}">
                    <c:HelpMark DockPanel.Dock="Right"
                            Text="{Binding Shared.ReadoutAssumptions}"
                            AutomationProperties.AutomationId="Detector.ReadoutAssumptionsHelp"
                            AutomationProperties.Name="Readout model assumptions" />
                    <TextBlock Text="Detector geometry" Style="{StaticResource Text.PanelTitle}" />
                </DockPanel>
                <TextBlock Text="{Binding Readout}" Style="{StaticResource Text.MonoCaption}" TextWrapping="Wrap"
                        Margin="{StaticResource Gap.Section}" AutomationProperties.AutomationId="Detector.Readout" />
                <DockPanel>
                    <c:HelpMark DockPanel.Dock="Right"
                            Text="Geometric active-area fraction describes the face, not detection efficiency. Acquired rate needs transport, energy response and a stated channel."
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="Detector.AreaHelp" AutomationProperties.Name="About active area" />
                    <TextBlock Text="Active area" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
