<UserControl x:Class="Gcam.Studio.Views.WaveformView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls"
        xmlns:views="clr-namespace:Gcam.Studio.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <!-- The Waveform workspace: a heading, the view switch (the same view-tab style as the left panel: Energy sum · Four
    outputs, always shown), the plots, and an error line. Energy sum is the direct readout's ADC sum and shaped output;
    Four outputs the physical readout's lanes A–D and their sum, or an empty state leading to the readout choice. The mode
    note, the selected event and the chain are in the right panel (WaveformPanel). -->
    <Border Style="{StaticResource Panel.Surface}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding CentreTitle}" Style="{StaticResource Text.PanelTitle}" />
            </DockPanel>
            <TabControl DockPanel.Dock="Top" Style="{StaticResource TabControl.Segment}" SelectedIndex="{Binding ScopeViewIndex}"
                    Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Waveform.Views"
                    AutomationProperties.Name="Waveform view">
                <TabItem Header="Energy sum" AutomationProperties.AutomationId="Waveform.EnergySumTab" />
                <TabItem Header="Four outputs (A–D)" AutomationProperties.AutomationId="Waveform.FourOutputsTab" />
            </TabControl>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource Text.CaptionWarning}" TextWrapping="Wrap" />
            <Grid>
                <views:ReadoutWaveformView Visibility="{Binding ShowLanes, Converter={StaticResource BoolToVis}}" />
                <views:EmptyReadoutState Visibility="{Binding ShowLanesEmpty, Converter={StaticResource BoolToVis}}" />
                <!-- The physical readout's energy sum is the Σ lane of Four outputs -->
                <TextBlock Text="With the physical readout the energy sum is the Σ lane of Four outputs (A–D)." Style="{StaticResource Text.Body}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                        Visibility="{Binding ShowSumPhysicalNote, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="Waveform.SumPhysicalNote" />
                <Grid Visibility="{Binding ShowSumPlots, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <c:PlotView Series="{Binding AdcSeries}" Markers="{Binding Markers}" ShareViewRange="True"
                            ViewRange="{Binding ViewRange, Mode=TwoWay}" XUnit="µs" YUnit="codes" XLabel="time from trigger (µs)"
                            YLabel="ADC codes · energy sum" EmptyText="Start acquisition and select an event"
                            AutomationProperties.AutomationId="Waveform.Adc" AutomationProperties.Name="Waveform ADC energy sum"
                            AutomationProperties.HelpText="Wheel or plus and minus to zoom; arrows to pan; Home to reset. Both traces share time." />
                    <Border Grid.Row="1" Style="{StaticResource Divider}" />
                    <c:PlotView Grid.Row="2" Series="{Binding ShapedSeries}" Markers="{Binding Markers}" ShowMarkerLabels="False"
                            ShareViewRange="True" ViewRange="{Binding ViewRange, Mode=TwoWay}" XUnit="µs" YUnit="codes"
                            XLabel="time from trigger (µs)" YLabel="integer shaped output" EmptyText="Integer RTL shaper output"
                            AutomationProperties.AutomationId="Waveform.Shaped"
                            AutomationProperties.Name="Waveform integer shaped output"
                            AutomationProperties.HelpText="Wheel or plus and minus to zoom; arrows to pan; Home to reset. Both traces share time." />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
