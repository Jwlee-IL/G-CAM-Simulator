<UserControl x:Class="Gcam.Studio.Views.ComparePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls">
    <Border Style="{StaticResource Panel.Surface}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Comparison" Style="{StaticResource Text.PanelTitle}" Margin="{StaticResource Gap.Field}" />
                <TextBlock Text="{Binding Selection}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Gap.Field}" />
                <DockPanel Margin="{StaticResource Gap.Field}">
                    <c:HelpMark DockPanel.Dock="Right" Text="{Binding AssignmentHelp}" AutomationProperties.AutomationId="Compare.PopulationHelp" AutomationProperties.Name="Assignment populations details" />
                    <TextBlock Text="{Binding SameShare}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" AutomationProperties.AutomationId="Compare.SameShare" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Facts}" Margin="{StaticResource Gap.Section}">
                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="{StaticResource Gap.Field}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="{StaticResource Gap.Field}">
                    <c:HelpMark DockPanel.Dock="Right" Text="{Binding CostHelp}" AutomationProperties.AutomationId="Compare.CostHelp" AutomationProperties.Name="Reference cost details" />
                    <TextBlock Text="Reference cost · 1 m" Style="{StaticResource Text.SectionTitle}" />
                </DockPanel>
                <TextBlock Text="{Binding Reference}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" AutomationProperties.AutomationId="Compare.Reference" />
                <TextBlock Text="F: equal-fluence MSE ratio, not a time factor. Remote: benchmark remote-peak probability. Intervals: 95% outer-seed clusters." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="{StaticResource Gap.Field}" />
                <ItemsControl ItemsSource="{Binding Costs}">
                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="{StaticResource Gap.Field}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Report export omits Compare." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
