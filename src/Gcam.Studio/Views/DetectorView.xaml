<UserControl x:Class="Gcam.Studio.Views.DetectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gcam.Studio.Controls" xmlns:views="clr-namespace:Gcam.Studio.Views">
    <Border Style="{StaticResource Panel.Surface}">
        <Grid>
        <views:ReadoutDetectorView><views:ReadoutDetectorView.Style><Style TargetType="views:ReadoutDetectorView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Shared.IsPhysicalReadout}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:ReadoutDetectorView.Style></views:ReadoutDetectorView>
        <DockPanel>
            <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Shared.IsPhysicalReadout}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Style="{StaticResource PanelHeader}"><TextBlock Text="Detector face · gain pattern" Style="{StaticResource Text.PanelTitle}" /></DockPanel>
                <TextBlock Text="{Binding Identity}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Field}"
                           AutomationProperties.AutomationId="Detector.Identity" />
            </StackPanel>
            <!-- Square face with its colour bar and legend directly beneath, at the face's width (ImageStackPanel) -->
            <c:ImageStackPanel>
                <c:DetectorFaceView Margin="{StaticResource Gap.Field}" Face="{Binding Face}" GapBrush="{DynamicResource Brush.Bg.Canvas}"
                                AutomationProperties.AutomationId="Detector.Face" AutomationProperties.Name="Detector face gain pattern"
                                AutomationProperties.HelpText="Static crystal gain pattern with exact reflector-gap rectangles. Geometric area is separate from acquired count rate." />
                <c:ColorBar Minimum="{Binding MinimumGain}" Maximum="{Binding MaximumGain}"
                            BarHeight="{StaticResource Size.ColorBar}" Foreground="{DynamicResource Brush.Text.Secondary}"
                            FontFamily="{StaticResource Font.Mono}" Margin="{StaticResource Gap.Tight}"
                            AutomationProperties.AutomationId="Detector.GainScale" AutomationProperties.Name="Detector relative gain colour scale" />
                <TextBlock Text="{Binding GainLegend}" Style="{StaticResource Text.MonoCaption}" TextWrapping="Wrap" />
                <TextBlock Text="Static relative gain · viridis scale · gaps are dead geometric area"
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Counts}" Style="{StaticResource Text.MonoCaption}" TextWrapping="Wrap" />
            </c:ImageStackPanel>
        </DockPanel>
        </Grid>
    </Border>
</UserControl>
