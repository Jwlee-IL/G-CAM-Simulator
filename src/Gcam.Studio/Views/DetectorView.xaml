<UserControl x:Class="Gcam.Studio.Views.DetectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls"
        xmlns:views="clr-namespace:Gcam.Studio.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <!-- The Detector workspace: a heading, the view switch (the same view-tab style as the left panel: Face · SiPM · Anger ·
    Calibration · Diagnostics, always shown), then the view. Face shows the detector face of either readout; the readout
    views show the physical readout, or an empty state leading to the readout choice while the direct crystal assignment
    is active. Legends and facts are in the right panel (DetectorPanel). -->
    <Border Style="{StaticResource Panel.Surface}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <TextBlock Text="{Binding CentreTitle}" Style="{StaticResource Text.PanelTitle}" />
            </DockPanel>
            <TabControl DockPanel.Dock="Top" Style="{StaticResource TabControl.Segment}" SelectedIndex="{Binding ReadoutTabIndex}"
                    Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Detector.Views"
                    AutomationProperties.Name="Detector view">
                <TabItem Header="Face" AutomationProperties.AutomationId="Detector.FaceTab" />
                <TabItem Header="SiPM" AutomationProperties.AutomationId="Readout.SipmTab" />
                <TabItem Header="Anger" AutomationProperties.AutomationId="Readout.AngerTab" />
                <TabItem Header="Calibration" AutomationProperties.AutomationId="Readout.CalibrationTab" />
                <TabItem Header="Diagnostics" AutomationProperties.AutomationId="Readout.DiagnosticsTab" />
            </TabControl>
            <Grid>
                <!-- Face: the square face with its colour bar directly beneath, at the face's width (ImageStackPanel) -->
                <c:ImageStackPanel Visibility="{Binding IsFaceView, Converter={StaticResource BoolToVis}}">
                    <c:DetectorFaceView Margin="{StaticResource Gap.Field}" Face="{Binding Face}"
                            GapBrush="{DynamicResource Brush.Bg.Canvas}" AutomationProperties.AutomationId="Detector.Face"
                            AutomationProperties.Name="Detector face gain pattern"
                            AutomationProperties.HelpText="Static crystal gain pattern with exact reflector-gap rectangles. Geometric area is separate from acquired count rate." />
                    <c:ColorBar Minimum="{Binding MinimumGain}" Maximum="{Binding MaximumGain}"
                            BarHeight="{StaticResource Size.ColorBar}" Foreground="{DynamicResource Brush.Text.Secondary}"
                            FontFamily="{StaticResource Font.Mono}" Margin="{StaticResource Gap.Tight}"
                            AutomationProperties.AutomationId="Detector.GainScale"
                            AutomationProperties.Name="Detector relative gain colour scale" />
                </c:ImageStackPanel>
                <views:ReadoutDetectorView Visibility="{Binding ShowReadoutView, Converter={StaticResource BoolToVis}}" />
                <views:EmptyReadoutState Visibility="{Binding ShowReadoutEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
