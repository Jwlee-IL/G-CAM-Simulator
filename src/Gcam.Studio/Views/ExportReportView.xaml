<UserControl x:Class="Gcam.Studio.Views.ExportReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Gcam.Studio.Converters">
    <StackPanel>
        <TextBlock Text="Export report" Style="{StaticResource Text.PanelTitle}" Margin="{StaticResource Gap.Section}" />
        <RadioButton Content="HTML" GroupName="ExportFormat" Foreground="{DynamicResource Brush.Text.Primary}" Margin="{StaticResource Gap.Field}"
                     IsChecked="{Binding Format, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Html}"
                     AutomationProperties.AutomationId="Export.Html" />
        <TextBlock Text="Self-contained report with vector figures." Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Section}" />
        <RadioButton Content="PDF" GroupName="ExportFormat" Foreground="{DynamicResource Brush.Text.Primary}" Margin="{StaticResource Gap.Field}"
                     IsChecked="{Binding Format, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Pdf}"
                     AutomationProperties.AutomationId="Export.Pdf" />
        <TextBlock Text="Printable report with vector figures." Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Section}" />
        <RadioButton Content="Word (.docx)" GroupName="ExportFormat" Foreground="{DynamicResource Brush.Text.Primary}" Margin="{StaticResource Gap.Field}"
                     IsChecked="{Binding Format, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Word}"
                     AutomationProperties.AutomationId="Export.Word" />
        <TextBlock Text="Editable document with PNG figures." Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Section}" />
        <RadioButton Content="JSON — four-channel ADC values" GroupName="ExportFormat" Foreground="{DynamicResource Brush.Text.Primary}" IsEnabled="{Binding HasAdc}" Margin="{StaticResource Gap.Field}"
                     IsChecked="{Binding Format, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Json}"
                     AutomationProperties.AutomationId="Export.Json" />
        <TextBlock Text="{Binding JsonReason}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Section}"
                   AutomationProperties.AutomationId="Export.JsonReason" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="{StaticResource Gap.Inline}" AutomationProperties.AutomationId="Modal.Cancel" />
            <Button Content="Export…" Command="{Binding ExportCommand}" IsDefault="True" AutomationProperties.AutomationId="Export.Confirm" />
        </StackPanel>
    </StackPanel>
</UserControl>
