<Window x:Class="Gcam.Studio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gcam.Studio.Core.ViewModels;assembly=Gcam.Studio.Core"
        xmlns:c="clr-namespace:Gcam.Studio.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GCAM Studio — coded-aperture imaging" Height="760" Width="1200"
        Background="{StaticResource Canvas}" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Scene editor ============ -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Sources" Style="{StaticResource SectionTitle}" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add" Command="{Binding AddSourceCommand}"
                            AutomationProperties.Name="Add source" />
                    <Button Content="Remove" Command="{Binding RemoveSourceCommand}"
                            AutomationProperties.Name="Remove selected source" />
                </StackPanel>

                <!-- Run controls pinned to the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Photons" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Photons, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Photon budget" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Simulate" Command="{Binding RunCommand}" FontWeight="SemiBold"
                                AutomationProperties.Name="Run simulation" />
                        <Button Content="Cancel" Command="{Binding RunCancelCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Cancel simulation" />
                    </StackPanel>
                    <ProgressBar Height="4" Margin="0,10,0,6" Maximum="1" Value="{Binding Progress}"
                                 Foreground="{StaticResource Accent}" BorderThickness="0"
                                 AutomationProperties.Name="Simulation progress" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <!-- Selected source properties -->
                <Grid DockPanel.Dock="Bottom" DataContext="{Binding SelectedSource}" Margin="0,12,0,0"
                      IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Margin" Value="0,3" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Text="Isotope" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                              ItemsSource="{x:Static vm:SourceItemViewModel.IsotopeNames}"
                              SelectedItem="{Binding Isotope}" AutomationProperties.Name="Isotope" />
                    <TextBlock Grid.Row="1" Text="X (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding X}" AutomationProperties.Name="Source X in millimetres" />
                    <TextBlock Grid.Row="2" Text="Y (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Y}" AutomationProperties.Name="Source Y in millimetres" />
                    <TextBlock Grid.Row="3" Text="Distance (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DistanceMm}" AutomationProperties.Name="Source distance in millimetres" />
                    <TextBlock Grid.Row="4" Text="Activity (µCi)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ActivityUCi}" AutomationProperties.Name="Source activity in microcuries" />
                </Grid>

                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                         DisplayMemberPath="Label" BorderBrush="{StaticResource Line}"
                         AutomationProperties.Name="Source list" />
            </DockPanel>
        </Border>

        <!-- ============ Images ============ -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Detector flood map" Style="{StaticResource SectionTitle}" />
                    <c:HeatmapView Image="{Binding Result.Flood}" OriginMm="{Binding Result.FloodOriginMm}"
                                   StepMm="{Binding Result.FloodStepMm}" EmptyText="Run a simulation to see the flood map"
                                   Foreground="{StaticResource Muted}"
                                   AutomationProperties.Name="Detector flood map"
                                   AutomationProperties.HelpText="Mouse wheel or plus and minus to zoom, drag or arrow keys to pan, double-click or 0 to reset" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Reconstruction (source plane)" Style="{StaticResource SectionTitle}" />
                    <c:HeatmapView Image="{Binding Result.Reconstruction}" OriginMm="{Binding Result.ReconOriginMm}"
                                   StepMm="{Binding Result.ReconStepMm}" EmptyText="Run a simulation to see the reconstruction"
                                   Foreground="{StaticResource Muted}"
                                   AutomationProperties.Name="Reconstruction image"
                                   AutomationProperties.HelpText="Mouse wheel or plus and minus to zoom, drag or arrow keys to pan, double-click or 0 to reset" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
