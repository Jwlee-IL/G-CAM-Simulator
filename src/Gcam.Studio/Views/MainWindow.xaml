<Window x:Class="Gcam.Studio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gcam.Studio.Core.ViewModels;assembly=Gcam.Studio.Core"
        xmlns:c="clr-namespace:Gcam.Studio.Controls"
        xmlns:views="clr-namespace:Gcam.Studio.Views"
        xmlns:conv="clr-namespace:Gcam.Studio.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GCAM Studio" Width="1440" Height="900" MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Canvas}" FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!--
        Fixed grid, flexible centre: the scene and measurement panels are a fixed width, the images take the rest, and the
        window has a minimum size (1280×800) instead of a fixed one, so it still works at 125/150 % scaling.
        Sizes, gaps, text roles and colours below come from Themes/*.xaml. The window's own default and minimum size
        are the only literal numbers: they are window policy, documented in DESIGN.Layout.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Field row: fixed-width label + control -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Width" Value="{StaticResource Size.FieldLabel}" />
        </Style>
        <Style x:Key="FieldRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="{StaticResource Gap.Field}" />
        </Style>

        <!-- Read-only key/value line (geometry) -->
        <Style x:Key="FactRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="{StaticResource Gap.Tight}" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Image panel parts: the heatmap keeps a gap to its colour bar, the bar a tight gap to the readout -->
        <Style x:Key="ImageColorBar" TargetType="c:ColorBar">
            <Setter Property="BarHeight" Value="{StaticResource Size.ColorBar}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="Margin" Value="{StaticResource Gap.Tight}" />
        </Style>
        <Style x:Key="ImageHeatmap" TargetType="c:HeatmapView">
            <Setter Property="ShowReadoutOverlay" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FrameBrush" Value="{DynamicResource Brush.Line.Control}" />
            <Setter Property="FocusBrush" Value="{DynamicResource Brush.Focus}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="Margin" Value="{StaticResource Gap.Field}" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding SelectWorkspaceCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding SelectWorkspaceCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding SelectWorkspaceCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding SelectWorkspaceCommand}" CommandParameter="3" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.Bar}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource Size.StatusBar}" />
        </Grid.RowDefinitions>

        <!-- ================= Top bar: identity · global settings · primary action ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1" Padding="{StaticResource Pad.Bar}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="{StaticResource Size.Logo}" Height="{StaticResource Size.Logo}" CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource Brush.Accent}" Margin="{StaticResource Gap.Inline}" />
                    <TextBlock Text="GCAM Studio" Style="{StaticResource Text.AppTitle}" Margin="{StaticResource Gap.Inline}" />
                    <Border Style="{StaticResource Segment.Track}"
                            Visibility="{Binding HasWorkspaceSwitch, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Title}" GroupName="Workspace" Style="{StaticResource RadioButton.Segment}"
                                                 IsChecked="{Binding IsActive}"
                                                 Command="{Binding DataContext.ActivateWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding AutomationId}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource Button.Ghost}" Margin="{StaticResource Gap.InlineWide}"
                            AutomationProperties.AutomationId="ThemeToggle" />
                    <TextBlock Text="Live time" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Inline}" />
                    <TextBox Width="{StaticResource Size.NumberInput.Short}" Height="{StaticResource Size.Control}" VerticalAlignment="Center" Tag="s" Text="{Binding LiveTimeS, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsIdle}" Margin="{StaticResource Gap.InlineWide}"
                             AutomationProperties.AutomationId="AcquisitionLiveTime" AutomationProperties.Name="Live time (s)" />
                    <TextBlock Text="Speed" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Inline}" />
                    <TextBox Width="{StaticResource Size.NumberInput.Short}" Height="{StaticResource Size.Control}" VerticalAlignment="Center" Tag="×" Text="{Binding Speed, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsIdle}" Margin="{StaticResource Gap.InlineWide}"
                             AutomationProperties.AutomationId="AcquisitionSpeed" AutomationProperties.Name="Speed × (live seconds per wall second)" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource Button.Primary}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                            Margin="{StaticResource Gap.Inline}" AutomationProperties.AutomationId="StopAcquisition" />
                    <Button Command="{Binding StartCommand}" Style="{StaticResource Button.Primary}" IsDefault="True"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="StartAcquisition" AutomationProperties.Name="Start">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}" Stretch="Uniform" Width="{StaticResource Size.Icon}" Height="{StaticResource Size.Icon}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="{StaticResource Gap.Inline}" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Border Grid.Row="1" Padding="{StaticResource Pad.Window}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Size.SidePanel}" />
                    <ColumnDefinition Width="{StaticResource Gutter}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Gutter}" />
                    <ColumnDefinition Width="{StaticResource Size.SidePanel}" />
                </Grid.ColumnDefinitions>

                <!-- Scene -->
                <Border Grid.Column="0" Style="{StaticResource Panel.Surface}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Style="{StaticResource PanelHeader}">
                            <TextBlock DockPanel.Dock="Left" Text="Sources" Style="{StaticResource Text.PanelTitle}" />
                            <Button DockPanel.Dock="Right" Content="−" Command="{Binding RemoveSourceCommand}"
                                    Style="{StaticResource Button.Ghost}" ToolTip="Remove selected source"
                                    AutomationProperties.AutomationId="RemoveSource" AutomationProperties.Name="Remove selected source" />
                            <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddSourceCommand}"
                                    Style="{StaticResource Button.Ghost}" ToolTip="Add source"
                                    AutomationProperties.AutomationId="AddSource" AutomationProperties.Name="Add source" />
                        </DockPanel>

                        <ListBox MaxHeight="{StaticResource Size.SourceList}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                                 Margin="{StaticResource Gap.Section}" AutomationProperties.AutomationId="SourceList" AutomationProperties.Name="Source list">
                            <!-- Without this a row's automation name is the ViewModel's type name. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Size.Column.Short}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Isotope}" Style="{StaticResource Text.Strong}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}">
                                            <Run Text="(" /><Run Text="{Binding X, Mode=OneWay, StringFormat={}{0:F0}}" /><Run Text=", " /><Run Text="{Binding Y, Mode=OneWay, StringFormat={}{0:F0}}" /><Run Text=") mm" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.MonoCaption}">
                                            <Run Text="{Binding ActivityUCi, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" µCi" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <views:ChainPanel Margin="{StaticResource Gap.Section}" />
                        <!-- Selected source -->
                        <StackPanel DataContext="{Binding SelectedSource}"
                                    IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <DockPanel Style="{StaticResource PanelHeader}">
                                <TextBlock Text="Selected source" Style="{StaticResource Text.SectionTitle}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Isotope" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:SourceItemViewModel.IsotopeNames}" SelectedItem="{Binding Isotope}"
                                          AutomationProperties.AutomationId="SourceIsotope" AutomationProperties.Name="Isotope" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding X}" Tag="mm" AutomationProperties.AutomationId="SourceX" AutomationProperties.Name="Source X in millimetres" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Y" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Y}" Tag="mm" AutomationProperties.AutomationId="SourceY" AutomationProperties.Name="Source Y in millimetres" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Distance" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DistanceMm}" Tag="mm" AutomationProperties.AutomationId="SourceDistance" AutomationProperties.Name="Source distance in millimetres" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Activity" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ActivityUCi}" Tag="µCi" AutomationProperties.AutomationId="SourceActivity" AutomationProperties.Name="Source activity in microcuries" />
                            </DockPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <Expander Header="Physical optics" Style="{StaticResource Expander.Section}"
                                  IsExpanded="{Binding IsOpticsExpanded}" AutomationProperties.AutomationId="Optics.Section">
                            <StackPanel DataContext="{Binding OpticsEditor}" IsEnabled="{Binding IsEditable}">
                                <TextBlock Text="Engineering geometry" Style="{StaticResource Text.Caption}" />
                                <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}"
                                          Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Optics.Preset"
                                          AutomationProperties.Name="Engineering geometry" />
                                <DockPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="Prime rank" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Ranks}" SelectedItem="{Binding Rank}"
                                              AutomationProperties.AutomationId="Optics.Rank" AutomationProperties.Name="Prime rank" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="Cell pitch" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CellPitch, UpdateSourceTrigger=PropertyChanged}" Tag="mm"
                                             AutomationProperties.AutomationId="Optics.CellPitch" AutomationProperties.Name="Cell pitch (mm)" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="Mask–detector" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" Tag="mm"
                                             AutomationProperties.AutomationId="Optics.Distance" AutomationProperties.Name="Mask–detector distance (mm)" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="Pixels / side" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Pixels, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="Optics.Pixels" AutomationProperties.Name="Pixels / side" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource FieldRow}">
                                    <TextBlock Text="Pixel pitch" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PixelPitch, UpdateSourceTrigger=PropertyChanged}" Tag="mm"
                                             AutomationProperties.AutomationId="Optics.PixelPitch" AutomationProperties.Name="Pixel pitch (mm)" />
                                </DockPanel>
                                <TextBlock Text="Performance depends on source positions, counts, isotope channels and focus."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding OpticsEditor.Summary}" Style="{StaticResource Text.MonoCaption}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OpticsEditor.Summary}" Visibility="{Binding IsOpticsExpanded, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding OpticsEditor.Error}" Style="{StaticResource Text.CaptionWarning}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="Optics.Error" />
                        <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.CaptionWarning}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="Acquisition.InputError" />
                        <Border Style="{StaticResource Divider}" />
                        <Expander Header="Detector" Style="{StaticResource Expander.Section}" IsExpanded="{Binding IsDetectorExpanded}"
                                  AutomationProperties.AutomationId="Detector.Section">
                            <StackPanel>
                        <StackPanel DataContext="{Binding Detector}">
                            <DockPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Entrance" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding EntranceAbsorberMm, StringFormat={}{0:0.##} mm steel}" Style="{StaticResource FactValue}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Backing" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding BackingScatterMm, StringFormat={}{0:0.##} mm steel}" Style="{StaticResource FactValue}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Gap" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ReflectorGapUm, UpdateSourceTrigger=PropertyChanged}" Tag="µm"
                                         AutomationProperties.AutomationId="Detector.Gap" AutomationProperties.Name="Gap reflector (µm)" />
                            </DockPanel>
                            <TextBlock Text="{Binding GapError}" Style="{StaticResource Text.CaptionWarning}" TextWrapping="Wrap" />
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Gain σ" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GainSigmaPercent}" Tag="%" AutomationProperties.AutomationId="Detector.GainSigma"
                                         AutomationProperties.Name="Gain σ (%)" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Gain seed" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GainSeed}" AutomationProperties.AutomationId="Detector.GainSeed"
                                         AutomationProperties.Name="Gain seed" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldRow}">
                                <TextBlock Text="Background" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BackgroundToSignalRatio}" Tag="× signal" AutomationProperties.AutomationId="Acquisition.Background"
                                         AutomationProperties.Name="Background BSR (detected background to signal ratio)" />
                            </DockPanel>
                        </StackPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding DetectorSummary}" Style="{StaticResource Text.MonoCaption}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DetectorSummary}" Visibility="{Binding IsDetectorExpanded, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <ContentControl Grid.Column="2" Content="{Binding SelectedWorkspace}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:SpectrumWorkspaceViewModel}"><views:SpectrumView /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:WaveformWorkspaceViewModel}"><views:WaveformView /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DetectorWorkspaceViewModel}"><views:DetectorView /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ImagingWorkspaceViewModel}">
                            <!-- Images: square heatmap with its colour bar and readout directly beneath (ImageStackPanel) -->
                            <DockPanel>
                            <views:FocusSweepView DockPanel.Dock="Bottom" Height="{StaticResource Size.FocusPlot}" Margin="{StaticResource Gap.Tight}"
                                                  Visibility="{Binding HasSweepResult, Converter={StaticResource BoolToVis}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource Gutter}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Panel.Surface}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                            <TextBlock DockPanel.Dock="Left" Text="Detector flood map" Style="{StaticResource Text.PanelTitle}" />
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                                    ToolTip="Detected events per crystal; each list-mode event contributes one count">
                                                <TextBlock Text="counts" Style="{StaticResource Text.Caption}" />
                                            </Border>
                                        </DockPanel>
                                        <c:ImageStackPanel>
                                            <c:HeatmapView x:Name="Flood" ValueUnit="counts" Style="{StaticResource ImageHeatmap}" Image="{Binding Result.Flood}"
                                                           OriginMm="{Binding Result.FloodOriginMm}" StepMm="{Binding Result.FloodStepMm}"
                                                           EmptyText="Run a simulation to see the flood map"
                                                           c:MeasurementOverlay.Session="{Binding Measurements}" c:MeasurementOverlay.Pane="Flood"
                                                           AutomationProperties.AutomationId="FloodView" AutomationProperties.Name="Detector flood map"
                                                           AutomationProperties.HelpText="Mouse wheel or plus and minus to zoom, drag or arrow keys to pan, double-click or 0 to reset. With a measuring tool, draw on the image; Escape cancels, Delete removes the selected measurement." />
                                            <c:ColorBar Style="{StaticResource ImageColorBar}" Minimum="{Binding DataMin, ElementName=Flood}" Maximum="{Binding DataMax, ElementName=Flood}"
                                                        AutomationProperties.AutomationId="FloodColorBar" AutomationProperties.Name="Flood map colour scale" />
                                            <TextBlock Text="{Binding Readout, ElementName=Flood}" Style="{StaticResource Text.Readout}"
                                                       AutomationProperties.AutomationId="FloodReadout" />
                                        </c:ImageStackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Panel.Surface}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                            <TextBlock DockPanel.Dock="Left" Text="Reconstruction" Style="{StaticResource Text.PanelTitle}" />
                                            <!-- The decoded peak is a reading, not an action or selection: neutral chip, mono numbers -->
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                                    Visibility="{Binding PeakText, Converter={x:Static conv:NullToCollapsedConverter.Instance}}">
                                                <TextBlock Text="{Binding PeakText}" Style="{StaticResource Text.MonoCaption}" AutomationProperties.AutomationId="PeakText" />
                                            </Border>
                                            <!-- The images no longer match the scene (a source was moved or edited) -->
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip.Warning}" Margin="{StaticResource Gap.Inline}"
                                                    Visibility="{Binding Shared.IsResultStale, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="The scene changed after this run. Simulate again to update the images.">
                                                <TextBlock Text="outdated" Style="{StaticResource Text.CaptionWarning}" AutomationProperties.AutomationId="ResultStale" />
                                            </Border>
                                        </DockPanel>
                                        <c:ImageStackPanel>
                                            <c:HeatmapView x:Name="Recon" ValueUnit="(decoded)" Style="{StaticResource ImageHeatmap}" Image="{Binding Result.Reconstruction}"
                                                           OriginMm="{Binding Result.ReconOriginMm}" StepMm="{Binding Result.ReconStepMm}"
                                                           c:MeasurementOverlay.FoundPeaks="{Binding Peaks}"
                                                           EmptyText="Run a simulation to see the reconstruction"
                                                           c:MeasurementOverlay.Session="{Binding Measurements}" c:MeasurementOverlay.Pane="Reconstruction"
                                                           c:MeasurementOverlay.Markers="{Binding Shared.Sources}" c:MeasurementOverlay.SelectedMarker="{Binding Shared.SelectedSource}"
                                                           c:MeasurementOverlay.CanMoveMarkers="{Binding Shared.IsIdle}"
                                                           AutomationProperties.AutomationId="ReconView" AutomationProperties.Name="Reconstruction image"
                                                           AutomationProperties.HelpText="Mouse wheel or plus and minus to zoom, drag or arrow keys to pan, double-click or 0 to reset. Drag a source marker to move the source. With a measuring tool, draw on the image; Escape cancels, Delete removes the selected measurement." />
                                            <c:ColorBar Style="{StaticResource ImageColorBar}" Minimum="{Binding DataMin, ElementName=Recon}" Maximum="{Binding DataMax, ElementName=Recon}"
                                                        AutomationProperties.AutomationId="ReconColorBar" AutomationProperties.Name="Reconstruction colour scale" />
                                            <TextBlock Text="{Binding Readout, ElementName=Recon}" Style="{StaticResource Text.Readout}"
                                                       AutomationProperties.AutomationId="ReconReadout" />
                                        </c:ImageStackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
                <ContentControl Grid.Column="4" Content="{Binding SelectedWorkspace}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:SpectrumWorkspaceViewModel}"><views:SpectrumPanel /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:WaveformWorkspaceViewModel}"><views:WaveformPanel /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DetectorWorkspaceViewModel}"><views:DetectorPanel /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ImagingWorkspaceViewModel}">
                            <!-- Measurements: tool picker · results table · detail of the selected row, top-aligned -->
                            <Border Style="{StaticResource Panel.Surface}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <views:ImagingOptionsPanel />
                                    <StackPanel DataContext="{Binding Measurements}">
                                        <DockPanel Style="{StaticResource PanelHeader}">
                                            <TextBlock Text="Tools" Style="{StaticResource Text.PanelTitle}" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Segment.Track}" Margin="{StaticResource Gap.Field}">
                                            <UniformGrid Rows="1" AutomationProperties.Name="Pointer tool">
                                                <RadioButton Content="_Pan" GroupName="Tool" Style="{StaticResource RadioButton.Segment}"
                                                             IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Pan}"
                                                             AutomationProperties.AutomationId="ToolPan" AutomationProperties.Name="Pan tool" />
                                                <RadioButton Content="_Distance" GroupName="Tool" Style="{StaticResource RadioButton.Segment}"
                                                             IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Distance}"
                                                             AutomationProperties.AutomationId="ToolDistance" AutomationProperties.Name="Distance tool" />
                                                <RadioButton Content="_Angle" GroupName="Tool" Style="{StaticResource RadioButton.Segment}"
                                                             IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Angle}"
                                                             AutomationProperties.AutomationId="ToolAngle" AutomationProperties.Name="Angle tool" />
                                                <RadioButton Content="_ROI" GroupName="Tool" Style="{StaticResource RadioButton.Segment}"
                                                             IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Roi}"
                                                             AutomationProperties.AutomationId="ToolRoi" AutomationProperties.Name="ROI tool (region of interest)" />
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="{Binding ToolHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Margin="{StaticResource Gap.Section}" AutomationProperties.AutomationId="ToolHint" />
    
                                        <DockPanel Style="{StaticResource PanelHeader}">
                                            <TextBlock DockPanel.Dock="Left" Text="Measurements" Style="{StaticResource Text.SectionTitle}" />
                                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}"
                                                    Style="{StaticResource Button.Ghost}" ToolTip="Remove all measurements"
                                                    AutomationProperties.AutomationId="ClearMeasurements" AutomationProperties.Name="Clear all measurements" />
                                            <Button DockPanel.Dock="Right" Content="−" Command="{Binding DeleteCommand}"
                                                    Style="{StaticResource Button.Ghost}" ToolTip="Delete selected measurement (Delete)"
                                                    AutomationProperties.AutomationId="DeleteMeasurement" AutomationProperties.Name="Delete selected measurement" />
                                        </DockPanel>
    
                                        <!-- Column header: same Size.Column.* keys and the same inner padding as the rows -->
                                        <Border Padding="{StaticResource Pad.ListItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource Size.Column.Id}" />
                                                    <ColumnDefinition Width="{StaticResource Size.Column.Short}" />
                                                    <ColumnDefinition Width="{StaticResource Size.Column.Short}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Text.ColumnHeader}" />
                                                <TextBlock Grid.Column="1" Text="Image" Style="{StaticResource Text.ColumnHeader}" />
                                                <TextBlock Grid.Column="2" Text="Kind" Style="{StaticResource Text.ColumnHeader}" />
                                                <TextBlock Grid.Column="3" Text="Value" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
    
                                        <Grid Margin="{StaticResource Gap.Field}">
                                            <ListBox MaxHeight="{StaticResource Size.ResultsList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                                                     AutomationProperties.AutomationId="MeasurementList" AutomationProperties.Name="Measurement results">
                                                <ListBox.InputBindings>
                                                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                                                </ListBox.InputBindings>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Name}" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:MeasurementViewModel}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{StaticResource Size.Column.Id}" />
                                                                <ColumnDefinition Width="{StaticResource Size.Column.Short}" />
                                                                <ColumnDefinition Width="{StaticResource Size.Column.Short}" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Mono}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding PaneLabel}" Style="{StaticResource Text.Label}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource Text.Label}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Value}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Border Padding="{StaticResource Pad.Panel}" VerticalAlignment="Top"
                                                    Visibility="{Binding HasItems, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="No measurements yet. Pick a tool and draw on an image." Style="{StaticResource Text.Caption}"
                                                           TextWrapping="Wrap" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
    
                                        <!-- Selected measurement: coordinates, size, pixel statistics — right under the table -->
                                        <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Text.MonoCaption}"
                                                   TextWrapping="Wrap" TextTrimming="None" AutomationProperties.AutomationId="MeasurementDetail" />
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Border>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,1,0,0" Padding="{StaticResource Pad.Bar}">
            <DockPanel>
                <!-- Progress only while running: a full accent bar at rest would be cyan that means nothing -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="{StaticResource Size.Progress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"
                                 Margin="{StaticResource Gap.Inline}" AutomationProperties.AutomationId="RunProgress" AutomationProperties.Name="Simulation progress" />
                    <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" Style="{StaticResource Text.MonoCaption}" />
                </StackPanel>
                <Ellipse Width="{StaticResource Size.StatusDot}" Height="{StaticResource Size.StatusDot}" Margin="{StaticResource Gap.Inline}" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Acquiring">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Stopped">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}"
                           AutomationProperties.AutomationId="StatusText" AutomationProperties.ItemStatus="{Binding State}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
