<Window x:Class="Gcam.Studio.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gcam.Studio.Core.ViewModels;assembly=Gcam.Studio.Core"
        xmlns:c="clr-namespace:Gcam.Studio.Controls" xmlns:services="clr-namespace:Gcam.Studio.Services"
        xmlns:views="clr-namespace:Gcam.Studio.Views" xmlns:conv="clr-namespace:Gcam.Studio.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}" Title="GCAM Studio" Width="1440"
        Height="900" MinWidth="1280" MinHeight="800" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource Brush.Bg.Canvas}" FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!--
    Fixed grid, flexible centre: the scene and measurement panels are a fixed width, the images take the rest, and the
    window has a minimum size (1280×800) instead of a fixed one, so it still works at 125/150 % scaling.
    Sizes, gaps, text roles and colours below come from Themes/*.xaml. The window's own default and minimum size
    are the only literal numbers: they are window policy, documented in DESIGN.Layout.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource Size.Caption}"
                ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type services:ConfirmationRequest}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PanelTitle}" Margin="{StaticResource Gap.Field}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                        Margin="{StaticResource Gap.Section}" AutomationProperties.AutomationId="Reset.Message" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsDefault="True"
                            Command="{Binding DataContext.Confirmation.CancelCommand, RelativeSource={RelativeSource AncestorType=c:ModalHost}}"
                            Margin="{StaticResource Gap.Inline}"
                            AutomationProperties.AutomationId="Modal.Cancel" />
                    <Button Content="Discard"
                            Command="{Binding DataContext.Confirmation.ConfirmCommand, RelativeSource={RelativeSource AncestorType=c:ModalHost}}"
                            AutomationProperties.AutomationId="Reset.Discard" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
            <views:OptionsView />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Field and fact row styles (FieldLabel, FieldRow, FactRow, FactValue) are shared in Themes/Controls.xaml. -->
        <!-- Image panel parts: the heatmap keeps a gap to its colour bar, the bar a tight gap to the readout -->
        <Style x:Key="ImageColorBar" TargetType="c:ColorBar">
            <Setter Property="BarHeight" Value="{StaticResource Size.ColorBar}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="Margin" Value="{StaticResource Gap.Tight}" />
        </Style>
        <Style x:Key="ImageHeatmap" TargetType="c:HeatmapView">
            <Setter Property="ShowReadoutOverlay" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FrameBrush" Value="{DynamicResource Brush.Line.Control}" />
            <Setter Property="FocusBrush" Value="{DynamicResource Brush.Focus}" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="Margin" Value="{StaticResource Gap.Field}" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding SelectWorkspaceCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding SelectWorkspaceCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding SelectWorkspaceCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding SelectWorkspaceCommand}" CommandParameter="3" />
        <!-- Measurement tool access keys (SR-A11Y-03): the icon toggles carry no text for an underlined access key, so the
        window binds Alt+P / D / A / R. The command acts only while Imaging is shown and no modal layer is open; a focused
        control that handles the combination keeps it (bindings only see unhandled keys). -->
        <KeyBinding Modifiers="Alt" Key="P" Command="{Binding SelectMeasureToolCommand}" CommandParameter="{x:Static vm:MeasureTool.Pan}" />
        <KeyBinding Modifiers="Alt" Key="D" Command="{Binding SelectMeasureToolCommand}" CommandParameter="{x:Static vm:MeasureTool.Distance}" />
        <KeyBinding Modifiers="Alt" Key="A" Command="{Binding SelectMeasureToolCommand}" CommandParameter="{x:Static vm:MeasureTool.Angle}" />
        <KeyBinding Modifiers="Alt" Key="R" Command="{Binding SelectMeasureToolCommand}" CommandParameter="{x:Static vm:MeasureTool.Roi}" />
    </Window.InputBindings>
    <c:WindowFrame>
        <c:ModalHost DialogContent="{Binding Confirmation.ActiveContent}"
                DialogName="{Binding Confirmation.ActiveContent.Title}" CancelCommand="{Binding Confirmation.CancelCommand}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource Size.Bar}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- ================= Top bar: identity · global settings · primary action ================= -->
                <!-- The bar owns its bottom line, so it runs the full width under the caption buttons too; the
                buttons fill the Size.Bar − 1 above it (= the chrome's Size.Caption) and rest transparent on the bar. -->
                <c:CaptionBar Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                        AutomationProperties.AutomationId="Window.TopBar" AutomationProperties.Name="Window caption">
                    <DockPanel>
                        <c:CaptionButtons DockPanel.Dock="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border Padding="{StaticResource Pad.Bar}">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Border Width="{StaticResource Size.Logo}" Height="{StaticResource Size.Logo}"
                                            CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Accent}"
                                            Margin="{StaticResource Gap.Inline}" />
                                    <TextBlock Text="GCAM Studio" Style="{StaticResource Text.AppTitle}" Margin="{StaticResource Gap.Inline}" />
                                    <Border shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Segment.Track}" Height="{StaticResource Size.Control}"
                                            Padding="{StaticResource Pad.None}" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="WorkspaceSwitch" Visibility="{Binding HasWorkspaceSwitch, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Workspaces}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Title}" GroupName="Workspace" Style="{StaticResource RadioButton.Segment}"
                                                            IsChecked="{Binding IsActive}"
                                                            Command="{Binding DataContext.ActivateWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding AutomationId}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                                <!-- Inputs, then the primary action, then the secondary actions: Start / Stop · Reset · Theme · Options;
                                the caption buttons follow at the far right. Every interactive control is hit-testable in the chrome. -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Live time" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Inline}" />
                                    <TextBox shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="{StaticResource Size.NumberInput.Short}" Height="{StaticResource Size.Control}"
                                            VerticalAlignment="Center" Tag="s" Text="{Binding LiveTimeS, UpdateSourceTrigger=LostFocus}"
                                            IsEnabled="{Binding CanEditLiveTime}" Margin="{StaticResource Gap.InlineWide}"
                                            ToolTip="Preset live time. After Stop or Completed it can be raised to continue, never lowered below the acquired live time."
                                            AutomationProperties.AutomationId="AcquisitionLiveTime" AutomationProperties.Name="Live time (s)" />
                                    <TextBlock Text="Speed" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Inline}" />
                                    <TextBox shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="{StaticResource Size.NumberInput.Short}" Height="{StaticResource Size.Control}"
                                            VerticalAlignment="Center" Tag="×" Text="{Binding Speed, UpdateSourceTrigger=LostFocus}"
                                            IsEnabled="{Binding CanEditSpeed}" Margin="{StaticResource Gap.InlineWide}"
                                            AutomationProperties.AutomationId="AcquisitionSpeed"
                                            AutomationProperties.Name="Speed × (live seconds per wall second)" />
                                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding StopCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource Button.Primary}" Height="{StaticResource Size.Control}" VerticalAlignment="Center"
                                            Margin="{StaticResource Gap.InlineWide}"
                                            AutomationProperties.AutomationId="StopAcquisition" AutomationProperties.Name="Stop">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Stop}" Stretch="Uniform"
                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Width="{StaticResource Size.Icon}" Height="{StaticResource Size.Icon}" Margin="{StaticResource Gap.Inline}" />
                                            <TextBlock Text="Stop" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Start, or Continue once data exist; not IsDefault: Enter in a field must not resume counting -->
                                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding StartCommand}" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource Button.Primary}" Height="{StaticResource Size.Control}" VerticalAlignment="Center"
                                            Margin="{StaticResource Gap.InlineWide}"
                                            AutomationProperties.AutomationId="StartAcquisition" AutomationProperties.Name="{Binding StartLabel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Play}" Stretch="Uniform"
                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Width="{StaticResource Size.Icon}" Height="{StaticResource Size.Icon}" Margin="{StaticResource Gap.Inline}" />
                                            <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Reset opens a deliberate discard confirmation. -->
                                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ResetCommand}" Content="{StaticResource Icon.Reset}" ToolTip="Reset acquisition"
                                            Style="{StaticResource Button.Icon}"
                                            Margin="{StaticResource Gap.InlineWide}"
                                            AutomationProperties.AutomationId="ResetAcquisition" AutomationProperties.Name="Reset acquisition" />
                                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ExportReportCommand}" Content="_Export report…"
                                            Height="{StaticResource Size.Control}" VerticalAlignment="Center" Margin="{StaticResource Gap.InlineWide}"
                                            AutomationProperties.AutomationId="ExportReport" />
                                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleLabel}"
                                            Style="{StaticResource Button.Theme}"
                                            Margin="{StaticResource Gap.InlineWide}"
                                            AutomationProperties.AutomationId="ThemeToggle" AutomationProperties.Name="{Binding ThemeToggleLabel}" />
                                    <Grid Width="{StaticResource Size.Control}" Height="{StaticResource Size.Control}"
                                            VerticalAlignment="Center" Margin="{StaticResource Gap.InlineWide}">
                                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding OpenOptionsCommand}" Content="{StaticResource Icon.Settings}" ToolTip="Options"
                                                AutomationProperties.AutomationId="OpenOptions" AutomationProperties.Name="Options"
                                                AutomationProperties.HelpText="{Binding OptionsHelpText}">
                                            <!-- Warning state: a Start was refused for an Options input that is still wrong (the dialog opens on click) -->
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOptionsWarning}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Ellipse Width="{StaticResource Size.OptionsBadge}" Height="{StaticResource Size.OptionsBadge}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="{StaticResource Gap.Caption.Focus}" IsHitTestVisible="False"
                                                AutomationProperties.AutomationId="Options.Badge">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Options.Badge}" />
                                                    <Setter Property="Visibility" Value="{Binding HasNonDefaultOptions, Converter={StaticResource BoolToVis}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOptionsWarning}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Status.Warning}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </c:CaptionBar>
                <!-- ================= Content ================= -->
                <Border Grid.Row="1" Padding="{StaticResource Pad.Window}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Size.SidePanel}" />
                            <ColumnDefinition Width="{StaticResource Gutter}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource Gutter}" />
                            <ColumnDefinition Width="{StaticResource Size.SidePanel}" />
                        </Grid.ColumnDefinitions>
                        <!-- Scene -->
                        <Border Grid.Column="0" Style="{StaticResource Panel.Surface}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationError}" Style="{StaticResource Text.CaptionWarning}"
                                        TextWrapping="Wrap" AutomationProperties.AutomationId="Acquisition.InputError" />
                                <TabControl Style="{StaticResource TabControl.Segment}" SelectedIndex="{Binding SelectedLeftTab}">
                                    <TabItem Header="Scene" AutomationProperties.AutomationId="Left.SceneTab">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="{StaticResource Gap.TabContent}">
                                                <DockPanel Style="{StaticResource PanelHeader}">
                                                    <TextBlock DockPanel.Dock="Left" Text="Sources" Style="{StaticResource Text.PanelTitle}" />
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding RemoveSourceCommand}" Content="{StaticResource Icon.Remove}"
                                                            ToolTip="Remove selected source"
                                                            Style="{StaticResource Button.Icon}"
                                                            AutomationProperties.AutomationId="RemoveSource" AutomationProperties.Name="Remove selected source" />
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding AddSourceCommand}" Content="{StaticResource Icon.Add}" ToolTip="Add source"
                                                            Style="{StaticResource Button.Icon}"
                                                            AutomationProperties.AutomationId="AddSource" AutomationProperties.Name="Add source" />
                                                </DockPanel>
                                                <ListBox MaxHeight="{StaticResource Size.SourceList}" ItemsSource="{Binding Sources}"
                                                        SelectedItem="{Binding SelectedSource}" Margin="{StaticResource Gap.Field}"
                                                        AutomationProperties.AutomationId="SourceList" AutomationProperties.Name="Source list">
                                                    <!-- Without this a row's automation name is the ViewModel's type name. -->
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{StaticResource Size.Column.Short}" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Isotope}" Style="{StaticResource Text.Strong}" />
                                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}">
                                                                    <Run Text="(" /><Run Text="{Binding X, Mode=OneWay, StringFormat={}{0:F0}}" /><Run Text=", " /><Run Text="{Binding Y, Mode=OneWay, StringFormat={}{0:F0}}" /><Run Text=") mm" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.MonoCaption}">
                                                                    <Run Text="{Binding ActivityUCi, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" µCi" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Border Style="{StaticResource Divider}" />
                                                <!-- Selected source -->
                                                <StackPanel DataContext="{Binding SelectedSource}" IsEnabled="{Binding IsEditable}">
                                                    <DockPanel Style="{StaticResource PanelHeader}">
                                                        <TextBlock Text="Selected source" Style="{StaticResource Text.PanelTitle}" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource FieldRow}">
                                                        <TextBlock Text="Isotope" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox ItemsSource="{x:Static vm:SourceItemViewModel.IsotopeNames}" SelectedItem="{Binding Isotope}"
                                                                AutomationProperties.AutomationId="SourceIsotope" AutomationProperties.Name="Isotope" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource FieldRow}">
                                                        <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding X}" Tag="mm" AutomationProperties.AutomationId="SourceX"
                                                                AutomationProperties.Name="Source X in millimetres" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource FieldRow}">
                                                        <TextBlock Text="Y" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding Y}" Tag="mm" AutomationProperties.AutomationId="SourceY"
                                                                AutomationProperties.Name="Source Y in millimetres" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource FieldRow}">
                                                        <TextBlock Text="Distance" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding DistanceMm}" Tag="mm" AutomationProperties.AutomationId="SourceDistance"
                                                                AutomationProperties.Name="Source distance in millimetres" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource FieldRow}">
                                                        <TextBlock Text="Activity" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding ActivityUCi}" Tag="µCi" AutomationProperties.AutomationId="SourceActivity"
                                                                AutomationProperties.Name="Source activity in microcuries" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Optics" AutomationProperties.AutomationId="Left.OpticsTab">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="{StaticResource Gap.TabContent}">
                                                <!-- One section in the left tabs' shared style (PanelHeader title, label / value rows).
                                                The fields are always shown: a preset writes its values and disables them, Custom enables them. -->
                                                <c:SettingsGroup DataContext="{Binding OpticsEditor}" IsEnabled="{Binding IsEditable}"
                                                        AutomationProperties.AutomationId="Optics.Section" AutomationProperties.Name="Optics settings">
                                                    <DockPanel Style="{StaticResource PanelHeader}">
                                                        <TextBlock Text="Engineering geometry" Style="{StaticResource Text.PanelTitle}" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource FieldRow}">
                                                        <TextBlock Text="Preset" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedIndex="{Binding SelectedPresetIndex}"
                                                                AutomationProperties.AutomationId="Optics.Preset"
                                                                AutomationProperties.Name="Preset (engineering geometry)" />
                                                    </DockPanel>
                                                    <StackPanel IsEnabled="{Binding IsCustom}">
                                                        <DockPanel Style="{StaticResource FieldRow}">
                                                            <TextBlock Text="Prime rank" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox ItemsSource="{Binding Ranks}" SelectedItem="{Binding Rank}"
                                                                    AutomationProperties.AutomationId="Optics.Rank" AutomationProperties.Name="Prime rank" />
                                                        </DockPanel>
                                                        <DockPanel Style="{StaticResource FieldRow}">
                                                            <TextBlock Text="Cell pitch" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding CellPitch, UpdateSourceTrigger=PropertyChanged}" Tag="mm"
                                                                    AutomationProperties.AutomationId="Optics.CellPitch" AutomationProperties.Name="Cell pitch (mm)" />
                                                        </DockPanel>
                                                        <DockPanel Style="{StaticResource FieldRow}">
                                                            <TextBlock Text="Mask–detector" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" Tag="mm"
                                                                    AutomationProperties.AutomationId="Optics.Distance" AutomationProperties.Name="Mask–detector distance (mm)" />
                                                        </DockPanel>
                                                        <DockPanel Style="{StaticResource FieldRow}">
                                                            <TextBlock Text="Pixels / side" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding Pixels, UpdateSourceTrigger=PropertyChanged}"
                                                                    AutomationProperties.AutomationId="Optics.Pixels" AutomationProperties.Name="Pixels / side" />
                                                        </DockPanel>
                                                        <DockPanel Style="{StaticResource FieldRow}">
                                                            <TextBlock Text="Pixel pitch" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding PixelPitch, UpdateSourceTrigger=PropertyChanged}" Tag="mm"
                                                                    AutomationProperties.AutomationId="Optics.PixelPitch" AutomationProperties.Name="Pixel pitch (mm)" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                    <DockPanel>
                                                        <c:HelpMark DockPanel.Dock="Right"
                                                                Text="Performance depends on source positions, counts, isotope channels and focus."
                                                                VerticalAlignment="Top"
                                                                AutomationProperties.AutomationId="Optics.PerformanceHelp"
                                                                AutomationProperties.Name="About geometry performance" />
                                                        <TextBlock Text="Geometry performance" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </c:SettingsGroup>
                                                <TextBlock Text="{Binding OpticsEditor.Error}" Style="{StaticResource Text.CaptionWarning}" TextWrapping="Wrap"
                                                        AutomationProperties.AutomationId="Optics.Error" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Detector" AutomationProperties.AutomationId="Left.DetectorTab">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="{StaticResource Gap.TabContent}">
                                                <c:SettingsGroup AutomationProperties.AutomationId="Detector.Section" AutomationProperties.Name="Readout settings">
                                                    <views:ReadoutPanel />
                                                </c:SettingsGroup>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Border>
                        <ContentControl Grid.Column="2" Content="{Binding SelectedWorkspace}" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:SpectrumWorkspaceViewModel}">
                                    <views:SpectrumView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:WaveformWorkspaceViewModel}">
                                    <views:WaveformView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:DetectorWorkspaceViewModel}">
                                    <views:DetectorView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ImagingWorkspaceViewModel}">
                                    <!-- Image pair on top (each a square heatmap with its colour bar and readout beneath, ImageStackPanel);
                                    measurements and, after a sweep, the focus curve fill the height below (ImageAreaPanel) -->
                                    <c:ImageAreaPanel MinRestHeight="{StaticResource Size.Imaging.Lower}">
                                        <Grid Margin="{StaticResource Gap.Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{StaticResource Gutter}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Panel.Surface}">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                                        <TextBlock DockPanel.Dock="Left" Text="Detector flood map" Style="{StaticResource Text.PanelTitle}" />
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" ToolTip="{Binding FloodHelp}">
                                                            <TextBlock Text="{Binding FloodCaption}" Style="{StaticResource Text.Caption}"
                                                                    AutomationProperties.AutomationId="FloodValueUnit" />
                                                        </Border>
                                                    </DockPanel>
                                                    <c:ImageStackPanel>
                                                        <c:HeatmapView x:Name="Flood" ValueUnit="{Binding FloodUnit}" Style="{StaticResource ImageHeatmap}"
                                                                Image="{Binding Result.Flood}" OriginMm="{Binding Result.FloodOriginMm}"
                                                                StepMm="{Binding Result.FloodStepMm}" EmptyText="Start an acquisition to see the flood map"
                                                                c:MeasurementOverlay.Session="{Binding Measurements}" c:MeasurementOverlay.Pane="Flood"
                                                                AutomationProperties.AutomationId="FloodView" AutomationProperties.Name="Detector flood map"
                                                                AutomationProperties.HelpText="Mouse wheel or plus and minus to zoom, drag or arrow keys to pan, double-click or 0 to reset. With a measuring tool, draw on the image; Escape cancels, Delete removes the selected measurement." />
                                                        <c:ColorBar Style="{StaticResource ImageColorBar}" Minimum="{Binding DataMin, ElementName=Flood}"
                                                                Maximum="{Binding DataMax, ElementName=Flood}" AutomationProperties.AutomationId="FloodColorBar"
                                                                AutomationProperties.Name="Flood map colour scale" />
                                                        <TextBlock Text="{Binding Readout, ElementName=Flood}" Style="{StaticResource Text.Readout}"
                                                                AutomationProperties.AutomationId="FloodReadout" />
                                                    </c:ImageStackPanel>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource Panel.Surface}">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                                        <TextBlock DockPanel.Dock="Left" Text="Reconstruction" Style="{StaticResource Text.PanelTitle}" />
                                                        <!-- The decoded peak is a reading, not an action or selection: neutral chip, mono numbers -->
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                                                Visibility="{Binding PeakText, Converter={x:Static conv:NullToCollapsedConverter.Instance}}">
                                                            <TextBlock Text="{Binding PeakText}" Style="{StaticResource Text.MonoCaption}"
                                                                    AutomationProperties.AutomationId="PeakText" />
                                                        </Border>
                                                    </DockPanel>
                                                    <c:ImageStackPanel>
                                                        <c:HeatmapView x:Name="Recon" ValueUnit="{Binding ReconstructionUnit}" Style="{StaticResource ImageHeatmap}"
                                                                Image="{Binding Result.Reconstruction}" OriginMm="{Binding Result.ReconOriginMm}"
                                                                StepMm="{Binding Result.ReconStepMm}" c:MeasurementOverlay.FoundPeaks="{Binding Peaks}"
                                                                EmptyText="Start an acquisition to see the reconstruction"
                                                                c:MeasurementOverlay.Session="{Binding Measurements}" c:MeasurementOverlay.Pane="Reconstruction"
                                                                c:MeasurementOverlay.Markers="{Binding Shared.Sources}"
                                                                c:MeasurementOverlay.SelectedMarker="{Binding Shared.SelectedSource}"
                                                                c:MeasurementOverlay.CanMoveMarkers="False" AutomationProperties.AutomationId="ReconView"
                                                                AutomationProperties.Name="Reconstruction image"
                                                                AutomationProperties.HelpText="Mouse wheel or plus and minus to zoom, drag or arrow keys to pan, double-click or 0 to reset. With a measuring tool, draw on the image; Escape cancels, Delete removes the selected measurement." />
                                                        <c:ColorBar Style="{StaticResource ImageColorBar}" Minimum="{Binding DataMin, ElementName=Recon}"
                                                                Maximum="{Binding DataMax, ElementName=Recon}" AutomationProperties.AutomationId="ReconColorBar"
                                                                AutomationProperties.Name="Reconstruction colour scale" />
                                                        <TextBlock Text="{Binding Readout, ElementName=Recon}" Style="{StaticResource Text.Readout}"
                                                                AutomationProperties.AutomationId="ReconReadout" />
                                                    </c:ImageStackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{StaticResource Gutter}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Measurements: full width, or the left half beside the focus curve once a sweep has a result -->
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Panel.Surface}">
                                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSweepResult}" Value="True">
                                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel DataContext="{Binding Measurements}" Grid.IsSharedSizeScope="True">
                                                    <!-- Header: title, the pointer tools as icon toggles (one active tool; IconToggle reports the access key to UI
                                                    Automation), Clear all at the right.
                                                    A single measurement is deleted with its row's delete button or the Delete key. -->
                                                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                                        <TextBlock DockPanel.Dock="Left" Text="Measurements" Style="{StaticResource Text.PanelTitle}"
                                                                Margin="{StaticResource Gap.InlineWide}" />
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" AutomationProperties.Name="Pointer tool">
                                                            <c:IconToggle Content="{StaticResource Icon.Pan}" GroupName="Tool" Style="{StaticResource RadioButton.Icon}"
                                                                    IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Pan}"
                                                                    ToolTip="Pan (Alt+P)" Margin="{StaticResource Gap.Tool}"
                                                                    AutomationProperties.AutomationId="ToolPan" AutomationProperties.Name="Pan tool" AutomationProperties.AccessKey="Alt+P" />
                                                            <c:IconToggle Content="{StaticResource Icon.Ruler}" GroupName="Tool" Style="{StaticResource RadioButton.Icon}"
                                                                    IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Distance}"
                                                                    ToolTip="Distance (Alt+D)" Margin="{StaticResource Gap.Tool}"
                                                                    AutomationProperties.AutomationId="ToolDistance" AutomationProperties.Name="Distance tool" AutomationProperties.AccessKey="Alt+D" />
                                                            <c:IconToggle Content="{StaticResource Icon.Angle}" GroupName="Tool" Style="{StaticResource RadioButton.Icon}"
                                                                    IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Angle}"
                                                                    ToolTip="Angle (Alt+A)" Margin="{StaticResource Gap.Tool}"
                                                                    AutomationProperties.AutomationId="ToolAngle" AutomationProperties.Name="Angle tool" AutomationProperties.AccessKey="Alt+A" />
                                                            <c:IconToggle Content="{StaticResource Icon.Roi}" GroupName="Tool" Style="{StaticResource RadioButton.Icon}"
                                                                    IsChecked="{Binding ActiveTool, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Roi}"
                                                                    ToolTip="ROI, region of interest (Alt+R)"
                                                                    AutomationProperties.AutomationId="ToolRoi" AutomationProperties.Name="ROI tool (region of interest)"
                                                                    AutomationProperties.AccessKey="Alt+R" />
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Command="{Binding ClearCommand}" Content="{StaticResource Icon.Clear}" ToolTip="Clear all measurements"
                                                                Style="{StaticResource Button.Icon}"
                                                                AutomationProperties.AutomationId="ClearMeasurements" AutomationProperties.Name="Clear all measurements" />
                                                    </DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding ToolHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                            Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="ToolHint" />
                                                    <!-- Column header: the same shared Auto columns (scope: this panel) and inner padding as the rows; the
                                                    Value column takes the rest and wraps rather than cuts when the panel is half width. -->
                                                    <Border DockPanel.Dock="Top" Padding="{StaticResource Pad.ListItem}" Margin="{StaticResource Gap.ScrollGutter}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MeasId" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MeasImage" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MeasKind" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.InlineWide}" />
                                                            <TextBlock Grid.Column="1" Text="Image" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.InlineWide}" />
                                                            <TextBlock Grid.Column="2" Text="Kind" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.InlineWide}" />
                                                            <TextBlock Grid.Column="3" Text="Value" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" />
                                                            <!-- The rows' delete column: same width and gap as the row button -->
                                                            <FrameworkElement Grid.Column="4" Width="{StaticResource Size.Control.Row}" Margin="{StaticResource Gap.RowAction}" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- Selected measurement: coordinates, size, pixel statistics — under the table -->
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Selected.Detail}" Style="{StaticResource Text.MonoCaption}"
                                                            TextWrapping="Wrap" TextTrimming="None" AutomationProperties.AutomationId="MeasurementDetail" />
                                                    <Grid Margin="{StaticResource Gap.Tight}">
                                                        <!-- Tab reaches the selected row, then its delete button, then leaves the list (other rows: arrow keys). -->
                                                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                                                                KeyboardNavigation.TabNavigation="Continue"
                                                                AutomationProperties.AutomationId="MeasurementList" AutomationProperties.Name="Measurement results">
                                                            <ListBox.InputBindings>
                                                                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                                                            </ListBox.InputBindings>
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                                                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Name}" />
                                                                    <Setter Property="IsTabStop" Value="False" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter Property="IsTabStop" Value="True" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:MeasurementViewModel}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MeasId" />
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MeasImage" />
                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MeasKind" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Mono}" Margin="{StaticResource Gap.InlineWide}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding PaneLabel}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.InlineWide}" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.InlineWide}" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding Value}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right"
                                                                                TextAlignment="Right" TextWrapping="Wrap" TextTrimming="None" />
                                                                        <!-- Deletes this row; shown on the selected row and under the pointer (the column is always reserved) -->
                                                                        <Button Grid.Column="4" Content="{StaticResource Icon.Cancel}" ToolTip="Delete measurement (Delete)"
                                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                CommandParameter="{Binding}" Margin="{StaticResource Gap.RowAction}"
                                                                                AutomationProperties.AutomationId="{Binding DeleteAutomationId}"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat='Delete measurement {0}'}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon.Row}">
                                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <Border Padding="{StaticResource Pad.Panel}" VerticalAlignment="Top"
                                                                Visibility="{Binding HasItems, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="No measurements yet. Pick a tool and draw on an image." Style="{StaticResource Text.Caption}"
                                                                    TextWrapping="Wrap" TextAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <views:FocusSweepView Grid.Column="2" Visibility="{Binding HasSweepResult, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </c:ImageAreaPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                        <ContentControl Grid.Column="4" Content="{Binding SelectedWorkspace}" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:SpectrumWorkspaceViewModel}">
                                    <views:SpectrumPanel />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:WaveformWorkspaceViewModel}">
                                    <views:WaveformPanel />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:DetectorWorkspaceViewModel}">
                                    <views:DetectorPanel />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ImagingWorkspaceViewModel}">
                                    <!-- Imaging settings: focal plane · channel · focus sweep (tools and measurements are under the images) -->
                                    <Border Style="{StaticResource Panel.Surface}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <views:ImagingOptionsPanel />
                                        </ScrollViewer>
                                    </Border>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Grid>
                </Border>
                <!-- ================= Status bar ================= -->
                <!-- One line in every state (height Size.Control): run status at the left, the Options summary at the right,
                then the top-bar input messages and, while running, the progress. Both texts trim with an ellipsis and keep their
                full text as tooltip and accessible name (a TextBlock's name is its whole text); a refused Start takes the
                status text in the warning colour. -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0" Padding="{StaticResource Pad.Bar}" AutomationProperties.AutomationId="Window.StatusBar">
                    <Grid Height="{StaticResource Size.Control}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="{StaticResource Size.StatusDot}" Height="{StaticResource Size.StatusDot}"
                                    Margin="{StaticResource Gap.Inline}" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Disabled}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Acquiring">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Stopped">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" Margin="{StaticResource Gap.InlineWide}"
                                AutomationProperties.AutomationId="StatusText" AutomationProperties.ItemStatus="{Binding State}"
                                AutomationProperties.LiveSetting="Polite">
                            <!-- A refused Start (validation or Options) reads in the warning colour until the next start or Reset. -->
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding OptionsStatusSummary}" ToolTip="{Binding OptionsStatusSummary}"
                                TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                                AutomationProperties.AutomationId="Options.Summary">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNonDefaultOptions}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OptionsStatusSummary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Top-bar input messages (the bar has no room under its fields): a rejected preset, an invalid seed -->
                        <TextBlock Grid.Column="3" Text="{Binding LiveTimeError}" Style="{StaticResource Text.CaptionWarning}"
                                VerticalAlignment="Center" TextWrapping="NoWrap"
                                Visibility="{Binding LiveTimeError, Converter={x:Static conv:NullToCollapsedConverter.Instance}}"
                                Margin="{StaticResource Gap.InlineWide.Leading}" AutomationProperties.AutomationId="AcquisitionLiveTimeError" />
                        <TextBlock Grid.Column="4" Text="{Binding SeedError}" Style="{StaticResource Text.CaptionWarning}"
                                VerticalAlignment="Center" TextWrapping="NoWrap"
                                Visibility="{Binding ShowSeedErrorInStatus, Converter={StaticResource BoolToVis}}"
                                Margin="{StaticResource Gap.InlineWide.Leading}" AutomationProperties.AutomationId="AcquisitionSeedError" />
                        <!-- One progress element for whichever runs (acquisition and readout preparation never run together),
                        only while running: a full accent bar at rest would be cyan that means nothing. -->
                        <Grid Grid.Column="5" Margin="{StaticResource Gap.InlineWide.Leading}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Width="{StaticResource Size.Progress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                        VerticalAlignment="Center" Margin="{StaticResource Gap.Inline}"
                                        AutomationProperties.AutomationId="RunProgress" AutomationProperties.Name="Simulation progress" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" Style="{StaticResource Text.MonoCaption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPreparingReadout, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Width="{StaticResource Size.Progress}" Maximum="1" Value="{Binding ReadoutProgress, Mode=OneWay}"
                                        VerticalAlignment="Center" Margin="{StaticResource Gap.Inline}"
                                        AutomationProperties.AutomationId="Readout.Progress"
                                        AutomationProperties.Name="Readout preparation progress" />
                                <TextBlock Text="{Binding ReadoutProgress, StringFormat={}{0:P0}}" Style="{StaticResource Text.MonoCaption}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </c:ModalHost>
    </c:WindowFrame>
</Window>
