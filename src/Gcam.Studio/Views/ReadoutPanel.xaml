<UserControl x:Class="Gcam.Studio.Views.ReadoutPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Gcam.Studio.Controls"
        xmlns:vm="clr-namespace:Gcam.Studio.Core.ViewModels;assembly=Gcam.Studio.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PhysicalVisibility" />
        <!-- The status word of a calibration-line cell; its detail below uses Text.Caption. -->
        <Style x:Key="Readout.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <!-- Preparation state: one line, hidden when the ready table shows the bank (ReadoutReadyRows non-empty). -->
        <Style x:Key="Readout.StateLine" TargetType="TextBlock" BasedOn="{StaticResource Text.MonoCaption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadoutReadyRows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Readout.ReadyTable" TargetType="StackPanel">
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadoutReadyRows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Readout.CellDetail" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Sections in the left tabs' shared style: a PanelHeader title, a Divider between sections. Readout · Calibration
    lines · Preparation · Energy window; DirectCrystal shows the Readout section only. State, refusals, local state and
    progress stay inline; assumptions and provenance sit behind help marks. -->
    <StackPanel>
        <!-- ===== Readout ===== -->
        <DockPanel Style="{StaticResource PanelHeader}">
            <TextBlock DockPanel.Dock="Left" Text="Readout" Style="{StaticResource Text.PanelTitle}" />
            <c:HelpMark DockPanel.Dock="Right"
                    Text="{Binding ReadoutAssumptions}"
                    AutomationProperties.AutomationId="Readout.AssumptionsHelp"
                    AutomationProperties.Name="Readout model assumptions" />
        </DockPanel>
        <!-- "Choose readout…" in an empty readout view selects this tab and focuses this combo (FocusRequest). -->
        <ComboBox ItemsSource="{Binding ReadoutModes}" SelectedItem="{Binding ReadoutMode}"
                IsEnabled="{Binding CanEditInputs}" Margin="{StaticResource Gap.Tight}"
                c:FocusRequest.Counter="{Binding ReadoutModeFocusRequest}"
                AutomationProperties.AutomationId="Readout.Mode" AutomationProperties.Name="Readout mode" />
        <TextBlock Text="{Binding ReadoutModeSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.ModeSummary" />
        <StackPanel Visibility="{Binding IsPhysicalReadout, Converter={StaticResource PhysicalVisibility}}">
            <DockPanel Margin="{StaticResource Gap.Field}">
                <c:HelpMark DockPanel.Dock="Right"
                        Text="{Binding ReadoutLocalisationHelp}"
                        AutomationProperties.AutomationId="Readout.LocalisationHelp"
                        AutomationProperties.Name="About experimental localisation cost" />
                <TextBlock Text="experimental readout · localisation cost (EV-36)" Style="{StaticResource Text.Caption}"
                        TextWrapping="Wrap" />
            </DockPanel>
            <Border Style="{StaticResource Divider}" />

            <!-- ===== Calibration lines: one row per line, columns line · record · local, help mark at the right ===== -->
            <DockPanel Style="{StaticResource PanelHeader}">
                <TextBlock DockPanel.Dock="Left" Text="Calibration lines" Style="{StaticResource Text.PanelTitle}" />
            </DockPanel>
            <!-- The line column is shared between the header and every row (Auto, SharedSizeGroup), and every row reserves
            the same help-mark width at the right (the header a blank of that width), so the two star columns line up from
            row to row. -->
            <StackPanel Grid.IsSharedSizeScope="True">
                <DockPanel Margin="{StaticResource Gap.Tight}">
                    <FrameworkElement DockPanel.Dock="Right" Width="{StaticResource Size.HelpMark}" Margin="{StaticResource Gap.HelpMark}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ReadoutLine" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="keV" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.Inline}" />
                        <TextBlock Grid.Column="1" Text="Record" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.Inline}" />
                        <TextBlock Grid.Column="2" Text="Local" Style="{StaticResource Text.ColumnHeader}" />
                    </Grid>
                </DockPanel>
                <!-- Rows are exposed through their help marks: each mark is named after its row (the visible summary and local
                state) and carries the full record sentence as HelpText, so a screen reader announces both with one focusable
                element. -->
                <c:ContentItemsList ItemsSource="{Binding ReadoutLines}"
                        AutomationProperties.AutomationId="Readout.Lines" AutomationProperties.Name="Calibration lines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{StaticResource Gap.Field}">
                                <c:HelpMark DockPanel.Dock="Right"
                                        Text="{Binding Details}"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="{Binding HelpId}" AutomationProperties.Name="{Binding AccessibleName}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ReadoutLine" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="{StaticResource Gap.Inline}">
                                        <TextBlock Text="{Binding EnergyText}" Style="{StaticResource Text.Mono}" />
                                        <TextBlock Text="{Binding SceneText}" Style="{StaticResource Readout.CellDetail}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource Gap.Inline}">
                                        <TextBlock Text="{Binding RecordLabel}" Style="{StaticResource Readout.Cell}" />
                                        <TextBlock Text="{Binding RecordDetail}" Style="{StaticResource Readout.CellDetail}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding LocalLabel}" Style="{StaticResource Readout.Cell}" />
                                        <TextBlock Text="{Binding LocalDetail}" Style="{StaticResource Readout.CellDetail}" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </c:ContentItemsList>
            </StackPanel>
            <Border Style="{StaticResource Divider}" />

            <!-- ===== Preparation: the actions sit in the section header (like the Sources + / −) ===== -->
            <DockPanel Style="{StaticResource PanelHeader}">
                <TextBlock DockPanel.Dock="Left" Text="Preparation" Style="{StaticResource Text.PanelTitle}" />
                <!-- One right-docked group, so the tab order follows the visual order (Prepare, then Cancel). -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Prepare starts a long computation the user waits for: the primary (accent) style, like Start -->
                    <Button Command="{Binding PrepareReadoutCommand}" Style="{StaticResource Button.Primary}"
                            Height="{StaticResource Size.Control}" VerticalAlignment="Center"
                            Margin="{StaticResource Gap.Inline}"
                            AutomationProperties.AutomationId="Readout.Prepare" AutomationProperties.Name="Prepare">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}" Stretch="Uniform"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Width="{StaticResource Size.Icon}" Height="{StaticResource Size.Icon}" Margin="{StaticResource Gap.Inline}" />
                            <TextBlock Text="Prepare" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PrepareReadoutCancelCommand}" Content="{StaticResource Icon.Cancel}"
                            ToolTip="Cancel prepare"
                            Style="{StaticResource Button.Icon}"
                            AutomationProperties.AutomationId="Readout.Cancel" AutomationProperties.Name="Cancel prepare" />
                </StackPanel>
            </DockPanel>
            <!-- The state keeps its AutomationId and its full text as the group's name. A ready bank shows "Ready" and a
            table (line · time · windowed · scored, one row per prepared line); every other state is one short line. -->
            <c:SettingsGroup Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.State"
                    AutomationProperties.Name="{Binding ReadoutState}">
                <!-- A short state word while preparing ("Preparing…"); the progress text and bar are in the status bar -->
                <TextBlock Text="{Binding ReadoutStateLine}" Style="{StaticResource Readout.StateLine}" />
                <StackPanel Style="{StaticResource Readout.ReadyTable}">
                    <TextBlock Text="Ready" Style="{StaticResource Readout.Cell}" Margin="{StaticResource Gap.Tight}" />
                    <Grid Margin="{StaticResource Gap.Tight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ReadyLine" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="keV" Style="{StaticResource Text.ColumnHeader}" Margin="{StaticResource Gap.Inline}" />
                        <TextBlock Grid.Column="1" Text="Time" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Windowed" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Scored" Style="{StaticResource Text.ColumnHeader}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ReadoutReadyRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{StaticResource Gap.Tight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ReadyLine" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LineKeV}" Style="{StaticResource Text.Mono}" Margin="{StaticResource Gap.Inline}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding Windowed}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding Scored}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:SettingsGroup>
            <Border Style="{StaticResource Divider}" />

            <!-- ===== Energy window: low and high side by side ===== -->
            <DockPanel Style="{StaticResource PanelHeader}">
                <TextBlock DockPanel.Dock="Left" Text="Energy window" Style="{StaticResource Text.PanelTitle}" />
                <TextBlock DockPanel.Dock="Right" Text="measured · inclusive keV" Style="{StaticResource Text.Caption}" />
            </DockPanel>
            <Grid Margin="{StaticResource Gap.Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding WindowLowKeV}" Tag="low" Margin="{StaticResource Gap.Inline}"
                        AutomationProperties.AutomationId="Readout.WindowLow" />
                <TextBox Grid.Column="1" Text="{Binding WindowHighKeV}" Tag="high"
                        AutomationProperties.AutomationId="Readout.WindowHigh" />
            </Grid>
            <TextBlock Text="{Binding WindowLine}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                    Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.WindowLine" />
            <!-- Presets around the window line: ±10 · ±15 (EV-36 benchmark) · ±20 · ±25 %. They write the fields (still
            editable); the matching preset is marked. ContentItemsList exposes each button (and its AutomationId) to UIA. -->
            <DockPanel Margin="{StaticResource Gap.Tight}">
                <c:HelpMark DockPanel.Dock="Right"
                        Text="{x:Static vm:MainViewModel.WindowPresetHelp}"
                        AutomationProperties.AutomationId="Readout.WindowPresetHelp"
                        AutomationProperties.Name="About the window presets" />
                <Border Style="{StaticResource Segment.Track}" Height="{StaticResource Size.Control}" Padding="{StaticResource Pad.None}">
                    <c:ContentItemsList ItemsSource="{Binding WindowPresets}" AutomationProperties.AutomationId="Readout.WindowPresets"
                            AutomationProperties.Name="Energy window presets">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Tag="{Binding IsActive}" ToolTip="{Binding ToolTip}"
                                        Command="{Binding DataContext.UseWindowPresetCommand, RelativeSource={RelativeSource AncestorType=c:ContentItemsList}}"
                                        CommandParameter="{Binding Fraction}" Style="{StaticResource Button.Segment}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding AccessibleName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </c:ContentItemsList>
                </Border>
            </DockPanel>
            <TextBlock Text="±15 % is the EV-36 benchmark (measured cost)." Style="{StaticResource Text.Caption}"
                    TextWrapping="Wrap" Margin="{StaticResource Gap.Field}" AutomationProperties.AutomationId="Readout.WindowPresetNote" />
        </StackPanel>
        <TextBlock Text="{Binding ReadoutMessage}" Style="{StaticResource Text.CaptionWarning}" TextWrapping="Wrap"
                AutomationProperties.AutomationId="Readout.Reason" />
    </StackPanel>
</UserControl>
