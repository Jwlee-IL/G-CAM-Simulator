<Window x:Class="Genoray.MonteCarlo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="GCAM — coded-aperture gamma-camera simulator" Height="880" Width="1180">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,2,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ SCENE EDITOR (above the tabs) ============================ -->
        <Border Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Margin="6,6,6,3" Padding="6"
                Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 2D lateral canvas: place sources by X,Y. The detector footprint sits at the centre. -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Scene  (click to add / select a source · x,y lateral, mm)"
                               FontWeight="Bold" Margin="2,0,0,4" />
                    <Border BorderBrush="#999" BorderThickness="1" Background="White">
                        <Canvas x:Name="SceneCanvas" Width="380" Height="230"
                                Background="Transparent" MouseLeftButtonDown="SceneCanvas_MouseDown" />
                    </Border>
                </StackPanel>

                <!-- Per-source properties + the single Simulate button. -->
                <StackPanel Grid.Column="1" Margin="12,18,4,0">
                    <TextBlock Text="Sources" FontWeight="Bold" />
                    <ListBox x:Name="SourceList" Height="78" Margin="0,2,0,4"
                             SelectionChanged="SourceList_SelectionChanged" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add source" Click="AddSource_Click" />
                        <Button Content="Remove" Click="RemoveSource_Click" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Decay (isotope)" />
                        <ComboBox x:Name="PropIsotope" Grid.Row="0" Grid.Column="1" Width="120"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  SelectionChanged="PropIsotope_Changed" />

                        <Label Grid.Row="1" Grid.Column="0" Content="Activity (µCi)" />
                        <TextBox x:Name="PropActivity" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                                 LostFocus="PropActivity_Changed" />

                        <Label Grid.Row="2" Grid.Column="0" Content="Distance (mm)" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="PropDistance" Minimum="200" Maximum="3000" Width="180"
                                    VerticalAlignment="Center" TickFrequency="50" IsSnapToTickEnabled="True"
                                    ValueChanged="PropDistance_Changed" />
                            <TextBlock x:Name="PropDistanceLabel" VerticalAlignment="Center" Margin="8,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PropXY" Foreground="#666" Margin="2,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SimulateButton" Content="▶  SIMULATE" Click="Simulate_Click"
                                FontWeight="Bold" Padding="14,6" />
                        <Label Content="Speed ×" />
                        <TextBox x:Name="LiveSpeed" Text="10" Width="46" />
                        <TextBlock x:Name="LiveStatus" VerticalAlignment="Center" Margin="10,0" Foreground="#444" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ ANALYSIS TABS ============================ -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="6,3,6,6">
            <TabItem Header="Waveform">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,6">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Scope rate (kcps)" />
                            <TextBox x:Name="WfRate" Text="50" />
                            <Label Content="Events" />
                            <TextBox x:Name="WfEvents" Text="40" />
                            <CheckBox x:Name="WfRealistic" Content="Realistic front-end" IsChecked="True"
                                      VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock x:Name="WfStatus" VerticalAlignment="Center" Margin="12,0" Foreground="#555" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Label Content="Scintillator" />
                            <ComboBox x:Name="FeScint" Width="120" VerticalAlignment="Center"
                                      SelectionChanged="FrontEnd_Changed" />
                            <Label Content="Photosensor" Margin="8,0,0,0" />
                            <ComboBox x:Name="FeSensor" Width="185" VerticalAlignment="Center"
                                      SelectionChanged="FrontEnd_Changed" />
                            <Label Content="Preamp" Margin="8,0,0,0" />
                            <ComboBox x:Name="FePreamp" Width="185" VerticalAlignment="Center"
                                      SelectionChanged="FrontEnd_Changed" />
                            <TextBlock x:Name="FeReadout" VerticalAlignment="Center" Margin="12,0" Foreground="#286" />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <sp:WpfPlot x:Name="WfAdcPlot" Grid.Row="0" />
                        <sp:WpfPlot x:Name="WfShapedPlot" Grid.Row="1" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Imaging">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,6">
                        <Label Content="Photons (MC budget)" />
                        <TextBox x:Name="ImgPhotons" Text="500000" Width="90" />
                        <Label Content="Background BSR" />
                        <TextBox x:Name="ImgBsr" Text="0" />
                        <Label Content="Pixel gain σ%" Margin="8,0,0,0" />
                        <TextBox x:Name="ImgGainSigma" Text="3"
                                 ToolTip="Per-crystal gain spread (fixed pattern, seeded): each pixel's 662 keV lands slightly off, so an off-gain crystal loses part of the photopeak from its LLD/ULD window — the crystal-to-crystal non-uniformity a real rig calibrates out per crystal." />
                        <Label Content="Seed" Margin="8,0,0,0" />
                        <TextBox x:Name="ImgUnifSeed" Text="1" Width="48"
                                 ToolTip="Seed for the per-pixel gain pattern — change it to draw a different detector." />
                        <CheckBox x:Name="AutoFocus" Content="Focus fusion (laser + image)" IsChecked="False"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  ToolTip="Cross-check the rangefinder against depth-from-focus: refine the range when the source is near, or flag when the laser hit a different surface than the source." />
                        <Button Content="Estimate depth (3D)" Click="EstimateDepth_Click" Margin="10,2,4,2" />
                        <TextBlock x:Name="ImgStatus" VerticalAlignment="Center" Margin="12,0" Foreground="#555" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <sp:WpfPlot x:Name="ImgFloodPlot" Grid.Column="0" />
                        <sp:WpfPlot x:Name="ImgReconPlot" Grid.Column="1" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Spectrum">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,6">
                      <StackPanel Orientation="Horizontal">
                        <Label Content="Peak window ±×FWHM" />
                        <TextBox x:Name="SpWindow" Text="1.5"
                                 ToolTip="Per-pixel photopeak LLD/ULD: the imaging window is 662 ± (this × FWHM), so only photopeak events (per crystal, gain-corrected) form the coded image. Applies on the next Simulate." />
                        <Label Content="Resolution %@662" Margin="8,0,0,0" />
                        <TextBox x:Name="SpResolution" Text="6" />
                        <CheckBox x:Name="SpLogY" Content="Log Y" IsChecked="False" VerticalAlignment="Center"
                                  Margin="8,0" Checked="SpLogY_Changed" Unchecked="SpLogY_Changed"
                                  ToolTip="Log counts axis — reveals the Compton continuum the photopeak dwarfs on a linear scale" />
                        <Label Content="Noise floor (cps)" Margin="8,0,0,0" />
                        <TextBox x:Name="SpNoiseCps" Text="0"
                                 ToolTip="Device electronics/EMI noise trigger rate — a source-INDEPENDENT low-energy population (not derivable from the datasheet; set it to match your rig)." />
                        <TextBlock Text="(press Simulate to accumulate)"
                                   VerticalAlignment="Center" Margin="10,0" Foreground="#888" />
                        <TextBlock x:Name="SpStatus" VerticalAlignment="Center" Margin="12,0" Foreground="#555" />
                      </StackPanel>
                    </StackPanel>
                    <sp:WpfPlot x:Name="SpPlot" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Optics / Presets">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="Preset" />
                        <ComboBox x:Name="OptPreset" Width="190" VerticalAlignment="Center"
                                  SelectionChanged="OptPreset_Changed">
                            <ComboBoxItem Content="Sharp (default)" />
                            <ComboBoxItem Content="Baseline (coarse)" />
                            <ComboBoxItem Content="Wide FOV" />
                            <ComboBoxItem Content="High-res" />
                        </ComboBox>
                        <TextBlock Text="  fills the fields below · optics changes apply on the next Simulate"
                                   VerticalAlignment="Center" Foreground="#888" />
                    </StackPanel>

                    <WrapPanel Margin="0,10">
                        <Label Content="MURA rank (prime)" />
                        <TextBox x:Name="OptRank" Text="13" />
                        <Label Content="Cell pitch (mm)" />
                        <TextBox x:Name="OptCell" Text="0.7" />
                        <Label Content="Mask–detector D (mm)" />
                        <TextBox x:Name="OptD" Text="80" />
                        <Label Content="Detector N (per side)" />
                        <TextBox x:Name="OptDetN" Text="30" />
                        <Label Content="Pixel pitch (mm)" />
                        <TextBox x:Name="OptDetPitch" Text="0.6" />
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Label Content="Rangefinder range (mm)" />
                        <Slider x:Name="OptFocal" Minimum="200" Maximum="3000" Value="1000" Width="260"
                                VerticalAlignment="Center" TickFrequency="50" IsSnapToTickEnabled="True"
                                ValueChanged="OptFocal_Changed" />
                        <TextBlock x:Name="OptFocalLabel" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Text="  external distance (laser). The aperture gives direction; this sets the range."
                                   VerticalAlignment="Center" Foreground="#888" />
                    </StackPanel>

                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,6" Background="#F7F7F7">
                        <TextBlock x:Name="OptReadout" FontFamily="Consolas" FontSize="12" />
                    </Border>

                    <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,6" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="Resolution element = cell pitch × (source distance) / D. Smaller cell or larger D sharpens it, but shrinks the FOV — raise the rank to widen the FOV back. The detector must sample the mask shadow at least twice per cell (Nyquist), so finer cells need a finer pixel pitch." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Detector">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,6">
                        <Label Content="Reflector gap (µm)" />
                        <TextBox x:Name="DetGapUm" Text="100" TextChanged="DetField_Changed"
                                 ToolTip="Dead reflector / saw-kerf gap between crystals. A photon entering the gap is lost, so the fill factor is ((pitch−gap)/pitch)². 0 = ideal 100% fill." />
                        <Button Content="Redraw" Click="DetRedraw_Click" Margin="10,2,4,2" />
                        <TextBlock x:Name="DetReadout" VerticalAlignment="Center" Margin="12,0" Foreground="#286" />
                    </StackPanel>
                    <sp:WpfPlot x:Name="DetPlot" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ============================ LOG (bottom row) ============================ -->
        <Border Grid.Row="2" BorderBrush="#BBB" BorderThickness="1" Margin="6,0,6,6" Background="#1E1E1E">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="Bold" Foreground="#DDD"
                           Margin="6,3,0,0" />
                <!-- Width="Auto" overrides the implicit TextBox style's fixed 72px so the log fills the row. -->
                <TextBox x:Name="LogBox" Height="96" Width="Auto" HorizontalAlignment="Stretch"
                         Margin="6,2,6,6" IsReadOnly="True"
                         Background="#1E1E1E" Foreground="#CFCFCF" FontFamily="Consolas" FontSize="11"
                         BorderThickness="0" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
