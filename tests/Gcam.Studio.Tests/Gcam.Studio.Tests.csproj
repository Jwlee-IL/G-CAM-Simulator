<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the presentation layer only — plain net9.0, no WPF. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="../../src/Gcam.Studio/Themes/Tokens.*.xaml" Link="Themes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gcam.Studio.Core\Gcam.Studio.Core.csproj" />
  </ItemGroup>

  <!-- Exercise the shipped record with its production parser and pin, keeping this headless project Core-only. -->
  <ItemGroup>
    <Compile Include="../../src/Gcam.Studio.Services/ReadoutOfferRecordLoader.cs" Link="Fixtures/ReadoutOfferRecordLoader.cs" />
    <Compile Include="../../src/Gcam.Studio.Services/ReadoutOfferPin.cs" Link="Fixtures/ReadoutOfferPin.cs" />
    <EmbeddedResource Include="../../samples/evidence/studio-readout/offer-cost-v1.json"
                      LogicalName="Gcam.Studio.Services.ReadoutOfferRecord.json" />
  </ItemGroup>

</Project>
