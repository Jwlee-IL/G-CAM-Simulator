  "steps": [
    {
      "n": 1,
      "text": "Select the **Optics** tab. **Preset** shows Sharp, the default engineering geometry. A preset writes its five values — **Prime rank**, **Cell pitch**, **Mask–detector**, **Pixels / side** and **Pixel pitch** — into the fields and keeps them read-only.",
      "labels": {
        "Left.OpticsTab": "Optics",
        "Optics.Preset": "Preset",
        "Optics.Rank": "Prime rank",
        "Optics.CellPitch": "Cell pitch",
        "Optics.Distance": "Mask–detector",
        "Optics.Pixels": "Pixels / side",
        "Optics.PixelPitch": "Pixel pitch"
      },
      "notices": [],
      "checks": [
