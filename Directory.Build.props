<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Gcam</Product>
    <!-- The SDK appends the git commit to the informational version ("1.0.0+<sha>"), so every commit, even one that
         changes only docs or tests, gave every assembly new bytes and invalidated the observed-run basis and the manual
         runs keyed on the deployment fingerprint (TODO-51). Provenance is the run records' commit beside that
         fingerprint, not a string inside the binary. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- SourceLink also wrote the commit into each PDB, and the DLL records its PDB's content identity, so the DLL bytes
         still followed the commit. No source-control queries at build time. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
</Project>
